<Project>
  <Import Project="$(MSBuildThisFileDirectory)build\Frameworks.props" />
  <!-- Target frameworks come from build/Frameworks.props (the dual-TFM policy lives there). Libraries
       and their tests build for every version; the handful of projects that are run rather than
       referenced build for the newest one only. -->
  <PropertyGroup Condition="!$(MmcaSingleTargetProjects.Contains(';$(MSBuildProjectName);')) And !$(MmcaOldestTargetProjects.Contains(';$(MSBuildProjectName);'))">
    <TargetFrameworks>$(MmcaNetVersions)</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$(MmcaSingleTargetProjects.Contains(';$(MSBuildProjectName);'))">
    <TargetFramework>$(MmcaDefaultNet)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(MmcaOldestTargetProjects.Contains(';$(MSBuildProjectName);'))">
    <TargetFramework>$(MmcaOldestNet)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- S8970 ("remove this null-forgiving operator; nullable warnings are disabled here") is new in
         SonarAnalyzer 10.30 and is wrong on every site it flags in this repo: all three are the
         deliberate `null!` / `default!` initializer pattern in .razor components, where removing the
         operator immediately fails the build with CS8625/CS8604. Suppressed HERE rather than in
         .editorconfig because a `dotnet_diagnostic` severity does not reach Razor-generated code.
         The compiler is the authority on nullability, not the analyzer. -->
    <!-- RS0041 ("public members should not use oblivious reference types") fires only on Razor
         generated code (BuildRenderTree and the component parameter surface), which is not
         nullable-annotated and is not ours to annotate. Suppressed HERE rather than in .editorconfig
         for the same reason as S8970 above: a `dotnet_diagnostic` severity does not reach generated
         code. The two rules that make the public API gate a gate, RS0016 and RS0017, stay at error. -->
    <!-- CS1591 (missing XML comment on a public member) is NOT suppressed here: it is ratcheted per
         project (FR-7), so a project not yet fully documented carries its own NoWarn line and a
         clean project cannot regress. -->
    <!-- S3881 ("fix this implementation of IDisposable") fires only on the Razor-GENERATED partial
         declaration of a component that implements IDisposable (the *_razor.decl.g.cs file the
         .NET 11 SDK Razor compiler emits), on both target frameworks. Same reasoning as S8970 and
         RS0041 above: an .editorconfig severity does not reach generated code. -->
    <NoWarn>$(NoWarn);RMG020;S8970;RS0041;S3881</NoWarn>
  </PropertyGroup>

  <!-- System.Net.Http.Json is an implicit using on net11.0 and not on net10.0. Declared here for
       both so no file carries a using directive that is required on one framework and IDE0005
       (unnecessary using) on the other. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!-- Accepted NuGet advisories: none today. Add each as
       <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-..." /> in an ItemGroup here,
       with its reachability argument in a comment; the CI audit step
       (.github/actions/nuget-vulnerability-audit) re-applies exactly this list. -->

  <!-- net11.0 ONLY, and a false positive rather than an accepted risk. The two
       System.Security.Cryptography.Pkcs advisories are fixed by the direct pin in
       Directory.Packages.props, and that pin is what a net11.0 app loads: the ASP.NET Core 11 shared
       framework carries the package at 11.0.0. Restore, though, prunes the 11.0.0 pin in every project
       that references that shared framework (its PackageOverrides.txt lists Pkcs|11.0.0, and a pin
       at or below that ceiling is pruned), then records and audits Microsoft.Data.SqlClient's
       unpruned transitive 9.0.18 instead, which never loads. net10.0 is unaffected because 10.0.14
       sits above the 10.0 ceiling. REMOVE these two entries when a Pkcs 11.0.1 exists and the net11.0
       value of MmcaFrameworkVersion moves to it: a pin above the ceiling is not pruned.
       The condition keeps restore-time audit fully armed for net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>

  <!-- Suppress xUnit1051 (CancellationToken propagation) in test projects.
       SYSLIB0066 (IStartupValidator is obsolete on net11.0 in favour of IAsyncStartupValidator, which
       net10.0 does not have): tests resolve the synchronous validator to trigger ValidateOnStart
       without booting a host, and that call is the same on both frameworks. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);xUnit1051;SYSLIB0066</NoWarn>
  </PropertyGroup>

  <!-- CA2263 (prefer generic overload): the NetArchTest-based architecture tests deliberately use
       the non-generic reflection overloads -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Architecture.Tests'))">
    <NoWarn>$(NoWarn);CA2263</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata (applied to all Source projects) -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('Source'))">
    <Authors>Ivan Ball</Authors>
    <Company>MMCA</Company>
    <Copyright>Copyright (c) Ivan Ball-llovera</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ivanball/MMCA.Common</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The nuget.org listing surface: project URL, icon, and tags are the entire first
         impression for anyone who finds a package through search rather than the docs site. -->
    <PackageProjectUrl>https://ivanball.github.io/platform.html</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>modular-monolith;clean-architecture;ddd;cqrs;microservices;dotnet;aspnetcore;aspire;efcore;blazor;outbox;result-pattern</PackageTags>
    <!-- The release notes live in one place (the GitHub releases feed) rather than being restated per
         package: every package ships in lockstep off a single tag (count in FACTS.md), and release.yml
         creates one GitHub release per tag, its notes taken from that version's CHANGELOG.md section. -->
    <PackageReleaseNotes>https://github.com/ivanball/MMCA.Common/releases</PackageReleaseNotes>
    <!-- GitHub Packages has no symbol server, so a standalone .snupkg cannot be consumed.
         Embed the PDB into the shipped DLL instead (with repo + untracked-source info), so the
         debug symbols actually reach consumers via the .nupkg. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- The icon referenced by PackageIcon above must itself be packed. Done once here rather than
       in every packable csproj (each of which still packs README.md individually). The changelog rides
       along in every package for the same reason: a consumer inspecting a .nupkg gets the version
       history without leaving the package. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('Source'))">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Public API surface gate. Every packable Source project declares its public surface in
    PublicAPI.Shipped.txt; RS0016 fails the build on a public member that is not declared and RS0017 on a
    declared member that disappeared, so widening or breaking the shipped API of a NuGet package becomes a
    reviewable diff in a text file instead of something a consumer discovers after the release.
    Source-only (tests have no shipped surface) and never on a .dcproj, mirroring the analyzer group below.
    MMCA.Common.UI.Maui is deliberately excluded: it lives outside MMCA.Common.slnx and builds only on the
    windows build-maui job across four MAUI TFMs (ADR-042), so its baseline could neither be bootstrapped
    nor kept honest from the normal build.
  -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('Source')) AND '$(MSBuildProjectExtension)' != '.dcproj' AND '$(MSBuildProjectName)' != 'MMCA.Common.UI.Maui'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <!--
    The five analyzers ride in as a per-project PackageReference from this file rather than as CPM's
    GlobalPackageReference, deliberately. A GlobalPackageReference carries its own version and would
    move the analyzer pins out of Directory.Packages.props, splitting the "every version lives in one
    file" rule across two files; it also fixes the asset metadata, whereas the PrivateAssets /
    IncludeAssets pair below has to stay explicit so an analyzer never flows to a consumer of a
    packed MMCA.Common package. And it is unconditional, while this ItemGroup carries the .dcproj
    condition that keeps Docker Compose projects out: they have no compiler to run an analyzer in and
    fail the restore when handed one.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Common projects link the UserIdentifierType alias from Common.Domain -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('MMCA.Common')) AND '$(MSBuildProjectName)' != 'MMCA.Common.Domain'">
    <Compile Include="$(MSBuildThisFileDirectory)Source\Core\MMCA.Common.Domain\GlobalUsings.IdentifierType.cs"
             Link="GlobalUsings\MMCA.Common.Domain.GlobalUsings.IdentifierType.cs" />
  </ItemGroup>

  <!-- Common projects link the Notification identifier type aliases from Common.Shared -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('MMCA.Common')) AND '$(MSBuildProjectName)' != 'MMCA.Common.Shared'">
    <Compile Include="$(MSBuildThisFileDirectory)Source\Core\MMCA.Common.Shared\GlobalUsings.NotificationIdentifierType.cs"
             Link="GlobalUsings\MMCA.Common.Shared.GlobalUsings.NotificationIdentifierType.cs" />
  </ItemGroup>

  <!-- Compile-time layer enforcement: validates ProjectReferences respect Clean Architecture -->
  <Import Project="$(MSBuildThisFileDirectory)Source\Build\MMCA.Common.LayerEnforcement.targets"
          Condition="$(MSBuildProjectDirectory.Contains('Source')) AND $(MSBuildProjectName.StartsWith('MMCA.Common'))" />

  <!--
    Contracts convention: any project ending in `.Contracts` automatically pulls in Grpc.Tools
    and compiles every .proto file under `Protos\` with both server stubs and client stubs.
    Used by extracted-service contract NuGet packages (e.g. `MMCA.Store.Catalog.Contracts`)
    so the same set of generated types is available to both producer and consumer projects.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Contracts'))">
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <Protobuf Include="Protos\**\*.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
