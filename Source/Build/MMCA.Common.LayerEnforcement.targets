<!--
  MMCA.Common Layer Enforcement
  ═══════════════════════════════════════════════════════════════════
  Validates that project references respect the Clean Architecture
  dependency flow at compile time:

    Shared → Domain → Application → Infrastructure → API
                                                       UI → Shared only

  Import this file from Directory.Build.props to enable enforcement.
  Each layer declares which MMCA.Common namespaces it is FORBIDDEN
  from referencing. If a ProjectReference violates the rule, the
  build fails with a descriptive error.
-->
<Project>

  <!-- ── Define forbidden references per layer ──────────────────── -->

  <!-- Shared: foundation layer — no upward references -->
  <Target Name="EnforceSharedLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.Shared'">
    <Error Condition="@(ProjectReference->AnyHaveMetadataValue('Identity', '%(Identity)')) != '' AND '%(ProjectReference.Filename)' == 'MMCA.Common.Domain'"
           Text="Layer violation: MMCA.Common.Shared must not reference MMCA.Common.Domain" />
    <ItemGroup>
      <_ForbiddenSharedRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.AI'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenSharedRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.Shared must not reference %(_ForbiddenSharedRefs.Filename). Shared is the foundation layer with no upward dependencies." />
  </Target>

  <!-- Domain: depends only on Shared -->
  <Target Name="EnforceDomainLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.Domain'">
    <ItemGroup>
      <_ForbiddenDomainRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.AI'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenDomainRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.Domain must not reference %(_ForbiddenDomainRefs.Filename). Domain depends only on Shared." />
  </Target>

  <!-- Application: depends on Domain + Shared -->
  <Target Name="EnforceApplicationLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.Application'">
    <ItemGroup>
      <_ForbiddenAppRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.AI'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenAppRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.Application must not reference %(_ForbiddenAppRefs.Filename). Application depends only on Domain and Shared (a language model is an Infrastructure-tier dependency: MMCA.Common.AI belongs behind Infrastructure)." />
  </Target>

  <!-- Infrastructure: depends on Application + Domain + Shared -->
  <Target Name="EnforceInfrastructureLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.Infrastructure'">
    <ItemGroup>
      <_ForbiddenInfraRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenInfraRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.Infrastructure must not reference %(_ForbiddenInfraRefs.Filename). Infrastructure must not depend on API/Presentation." />
  </Target>

  <!-- AI: the language-model boundary. It is an Infrastructure-TIER concern (it owns an external
       SDK and a provider credential) but it takes no core-layer reference at all: everything it
       governs is expressed in Microsoft.Extensions.AI primitives, so a host can install it without
       taking Domain, Application or Infrastructure. Naming each forbidden layer here is what keeps
       that true: the day this package reaches into Application for a convenience type, the model
       SDK stops being isolated behind one package and starts being load-bearing in the core.
       The runtime half is AiDependencyIsolationTestsBase (the other direction: no core layer may
       reference MMCA.Common.AI). -->
  <Target Name="EnforceAiLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.AI'">
    <ItemGroup>
      <_ForbiddenAiRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Grpc'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.UI'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenAiRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.AI must not reference %(_ForbiddenAiRefs.Filename). The language-model boundary depends on Microsoft.Extensions.AI and its provider SDK only." />
  </Target>

  <!-- UI: depends only on Shared -->
  <Target Name="EnforceUILayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.UI'">
    <ItemGroup>
      <_ForbiddenUIRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenUIRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.UI must not reference %(_ForbiddenUIRefs.Filename). UI depends only on Shared for Blazor WASM compatibility." />
  </Target>

  <!-- UI.Maui: native device-capability implementations for MAUI Blazor Hybrid heads —
       may reference UI and Shared only. Like UI itself, it must never see Domain,
       Application, Infrastructure, or API: capability services are pure presentation
       concerns resolved behind the contracts defined in MMCA.Common.UI. -->
  <Target Name="EnforceUIMauiLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.UI.Maui'">
    <ItemGroup>
      <_ForbiddenUIMauiRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenUIMauiRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.UI.Maui must not reference %(_ForbiddenUIMauiRefs.Filename). UI.Maui depends only on UI and Shared." />
  </Target>

  <!-- UI.Web: the server-side Blazor host bridge — may reference UI, API, Aspire, and Shared,
       but never the Domain/Application/Infrastructure layers directly (those flow transitively
       through API where legitimate; a direct reference would turn a host-support package into a
       backdoor around the layer rules). -->
  <Target Name="EnforceUIWebLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.UI.Web'">
    <ItemGroup>
      <_ForbiddenUIWebRefs Include="@(ProjectReference)"
        Condition="$([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenUIWebRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.UI.Web must not reference %(_ForbiddenUIWebRefs.Filename) directly. UI.Web bridges UI, API and Aspire only." />
  </Target>

  <!-- Testing.Aspire: AppHost integration test infrastructure. It is allowed the Aspire hosting
       PACKAGES (Aspire.Hosting + Aspire.Hosting.Testing, which is the AppHost-side application model
       it reads) and MMCA.Common.Testing, whose JWT generator and polling helper it reuses instead of
       restating. That one project reference is also its ceiling into Core: it may reach Application
       and API only transitively, through what MMCA.Common.Testing already pulls. A DIRECT reference
       to any core layer would let a test-infrastructure package become a backdoor around the layer
       rules, so each one is named here.

       MMCA.Common.Aspire (service defaults) is forbidden too, and that is deliberate rather than
       incidental: the probe paths this package asserts are MIRRORED constants cross-asserted by a
       unit test, precisely so an AppHost-tier package never drags the whole service-defaults graph
       (Azure Monitor, OpenTelemetry, Key Vault) into a consumer's test project. -->
  <Target Name="EnforceTestingAspireLayerBoundary"
          BeforeTargets="ResolveProjectReferences"
          Condition="$(MSBuildProjectName) == 'MMCA.Common.Testing.Aspire'">
    <ItemGroup>
      <!-- DefiningProjectName pins this to references THIS csproj declares. By the time
           ResolveProjectReferences runs, the SDK has folded the transitive closure into
           @(ProjectReference) as well, and MMCA.Common.Testing legitimately brings API and
           Application along that path. Judging the closure would forbid the very reference the rule
           allows; judging the declaration is the rule as written. -->
      <_ForbiddenTestingAspireRefs Include="@(ProjectReference)"
        Condition="'%(ProjectReference.DefiningProjectName)' == '$(MSBuildProjectName)'
               AND ($([System.String]::new('%(Filename)').Contains('MMCA.Common.Domain'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Application'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Infrastructure'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.API'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Grpc'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.UI'))
                OR $([System.String]::new('%(Filename)').Contains('MMCA.Common.Aspire')))" />
    </ItemGroup>
    <Error Condition="@(_ForbiddenTestingAspireRefs->Count()) &gt; 0"
           Text="Layer violation: MMCA.Common.Testing.Aspire must not reference %(_ForbiddenTestingAspireRefs.Filename) directly. It depends on MMCA.Common.Testing plus the Aspire hosting packages only." />
  </Target>

</Project>
