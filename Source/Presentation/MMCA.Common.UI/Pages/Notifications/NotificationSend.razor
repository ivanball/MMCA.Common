@page "/notifications/send"
@using Microsoft.AspNetCore.Authorization
@using MMCA.Common.UI.Common
@using MMCA.Common.UI.Validation
@attribute [Authorize]

<PageTitle>@Title</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-2" />
<MudText Typo="Typo.h4" Class="mb-4">@Title</MudText>

<MudCard Elevation="1" Class="mb-4 detail-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">@L["Notif.Send.Compose"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                @L["Notif.Send.Description"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @* No rule is declared here. Model + For + the shared Validation delegate run the
           DataAnnotations declared once on NotificationSendModel, and the remaining parameters are
           affordances read off that same model: Required drives the asterisk and aria-required (its
           message still comes from the model), MaxLength caps the input, Counter shows the budget. *@
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title"
                          For="@(() => _model.Title)"
                          Validation="@_validate"
                          Required="@ModelValidation.IsRequired(_model, nameof(NotificationSendModel.Title))"
                          Label="@L["Notif.Send.Field.Title"]"
                          MaxLength="@NotificationSendModel.TitleMaxLength"
                          Counter="@NotificationSendModel.TitleMaxLength"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.Body"
                          For="@(() => _model.Body)"
                          Validation="@_validate"
                          Required="@ModelValidation.IsRequired(_model, nameof(NotificationSendModel.Body))"
                          Label="@L["Notif.Send.Field.Message"]"
                          Lines="5"
                          MaxLength="@NotificationSendModel.BodyMaxLength"
                          Counter="@NotificationSendModel.BodyMaxLength"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-4" />
        </MudForm>
    </MudCardContent>
    <MudCardActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendNotificationAsync"
                   Disabled="IsSaving">
            @(IsSaving ? L["Notif.Send.Sending"] : L["Notif.Send.SendToAll"])
        </MudButton>
        <MudButton Color="Color.Default"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="NavigateToList"
                   Disabled="IsSaving">
            @L["Common.Button.Cancel"]
        </MudButton>
    </MudCardActions>
</MudCard>
