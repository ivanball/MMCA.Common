@page "/notifications/send"
@using Microsoft.AspNetCore.Authorization
@using MMCA.Common.Shared.Notifications.PushNotifications
@using MMCA.Common.UI.Common
@using MMCA.Common.UI.Validation
@attribute [Authorize]

<PageTitle>@Title</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-2" />
<MudText Typo="Typo.h4" Class="mb-4">@Title</MudText>

<MudCard Elevation="1" Class="mb-4 detail-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">@L["Notif.Send.Compose"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                @L["Notif.Send.Description"]
            </MudText>
            @* Only rendered when the app supplies a scope display name: a scoped send is targeted
               automatically, and the operator should see that target rather than infer it. *@
            @if (_scopeCaption is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Primary" Class="mmca-send-scope">
                    @_scopeCaption
                </MudText>
            }
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @* The send attempt's failure, localized and deduplicated once instead of per call site; it
           renders nothing until there is something to say. Deliberately NOT fed MudForm.Errors:
           every field already renders its own message inline, and MudBlazor contributes a generic
           "Required" of its own to that list, which would stack on top of the model's wording. A
           consumer form whose fields do not show their own messages passes them via Messages. *@
        <ErrorSummary Result="_sendResult" Localizer="L" />

        @* No rule is declared here. Model + For + the shared Validation delegate run the
           DataAnnotations declared once on NotificationSendModel, and the remaining parameters are
           affordances read off that same model: Required drives the asterisk and aria-required (its
           message still comes from the model), MaxLength caps the input, Counter shows the budget
           (the numbers come from the shared request contract, so they cannot drift from the server). *@
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title"
                          For="@(() => _model.Title)"
                          Validation="@_validate"
                          Required="@ModelValidation.IsRequired(_model, nameof(NotificationSendModel.Title))"
                          Label="@L["Notif.Send.Field.Title"]"
                          MaxLength="@SendPushNotificationRequest.TitleMaxLength"
                          Counter="@SendPushNotificationRequest.TitleMaxLength"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.Body"
                          For="@(() => _model.Body)"
                          Validation="@_validate"
                          Required="@ModelValidation.IsRequired(_model, nameof(NotificationSendModel.Body))"
                          Label="@L["Notif.Send.Field.Message"]"
                          Lines="5"
                          MaxLength="@SendPushNotificationRequest.BodyMaxLength"
                          Counter="@SendPushNotificationRequest.BodyMaxLength"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-4" />
        </MudForm>
    </MudCardContent>
    <MudCardActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendNotificationAsync"
                   Disabled="IsSaving">
            @(IsSaving ? L["Notif.Send.Sending"] : L["Notif.Send.SendToAll"])
        </MudButton>
        <MudButton Color="Color.Default"
                   Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="NavigateToList"
                   Disabled="IsSaving">
            @L["Common.Button.Cancel"]
        </MudButton>
    </MudCardActions>
</MudCard>
