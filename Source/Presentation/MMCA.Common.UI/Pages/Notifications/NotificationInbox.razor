@page "/notifications/inbox"
@page "/notifications/inbox/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using MMCA.Common.Shared.Notifications.UserNotifications
@attribute [Authorize]

<PageTitle>@Title</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-2" />
@* HtmlTag="h1": the page's required level-one heading, and what FocusOnNavigate targets. *@
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@Title</MudText>

@if (_notifications.Count > 0)
{
    <MudButton Color="Color.Primary"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.DoneAll"
               OnClick="MarkAllReadAsync"
               Disabled="IsSaving"
               Class="mb-4">
        @L["Notif.MarkAllRead"]
    </MudButton>
}

@if (IsLoading)
{
    @* Same live-region shape as PageLoadingState: role="status" carries the announcement (a bare div
       may not take aria-label) and the bar itself carries the accessible name. *@
    <div role="status" aria-live="polite" aria-busy="true">
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4"
                           aria-label="@L["Loading.Label"]" />
    </div>
}
else if (_notifications.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["Notif.Inbox.Empty"]</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var notification in _notifications)
        {
            <MudCard id="@CardElementId(notification)"
                     Elevation="@CardElevation(notification)"
                     Class="@CardClass(notification)"
                     Style="@CardStyle(notification)">
                <MudCardContent Class="py-2">
                    <div class="d-flex align-center justify-space-between">
                        <div class="flex-grow-1">
                            <MudText Typo="@(notification.IsRead ? Typo.body1 : Typo.subtitle1)">
                                @notification.Title
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                                @notification.Body
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @notification.SentOn.ToString("g")
                            </MudText>
                        </div>
                        @if (!notification.IsRead)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           aria-label="@L["Notif.MarkRead.Aria"]"
                                           OnClick="() => MarkReadAsync(notification)"
                                           Disabled="IsSaving" />
                        }
                        else
                        {
                            @* Title, not a bare icon: this tick is the ONLY thing that distinguishes a
                               read row from an unread one, so without a name the distinction is
                               carried by shape and colour alone (WCAG 1.1.1 / 1.4.1). *@
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                     Color="Color.Success"
                                     Size="Size.Small"
                                     Title="@L["Notif.Read.Aria"]"
                                     Class="ml-2" />
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>

    <MudPagination Class="mt-4"
                   Count="@_totalPages"
                   Selected="@_currentPage"
                   SelectedChanged="OnPageChangedAsync"
                   ShowFirstButton="true"
                   ShowLastButton="true" />
}
