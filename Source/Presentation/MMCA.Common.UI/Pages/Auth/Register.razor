@page "/register"
@using MMCA.Common.UI.Validation
@using MMCA.Common.Shared.Abstractions
@using MMCA.Common.Shared.Auth
@using MMCA.Common.Shared.Auth.Requests
@using MMCA.Common.Shared.ValueObjects.Contact
@using MMCA.Common.UI.Common
@using MMCA.Common.UI.Services.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using MMCA.Common.UI.Common.Settings
@using MMCA.Common.UI.Components.Capabilities
@attribute [StreamRendering(false)]
@inject IAuthUIService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject IOptions<LegalSettings> LegalOptions
@inject IOptions<RegistrationSettings> RegistrationOptions
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.Register.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="auth-container">
    <div class="d-flex flex-column align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large"
                 Color="Color.Primary" Class="mb-2" />
        @* HtmlTag="h1": the page's required level-one heading, and what FocusOnNavigate targets. *@
        <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">@L["Auth.Register.Title"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @* Generic subtitle (ADR-027): the previous literal was ADC-conference copy leaking into
               every consumer of this shared page. *@
            @L["Auth.Register.Subtitle"]
        </MudText>
    </div>

    <MudCard Elevation="1">
        <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
            <LocalizedDataAnnotationsValidator />
            <MudCardContent Class="pa-6">
                @* _rejectedEmail is the address the server rejected, exactly as submitted, so the alert can
                   only ever name an address the server checked, never the live field. Rule: a rejection
                   stands only while the field still holds that address. The first time the field differs
                   (an edit after the answer, or one made while the request was in flight) OnEmailEdited
                   dismisses it for good, so typing the same address back shows nothing until the next
                   submit re-checks it. *@
                @if (_rejectedEmail is not null)
                {
                    @* The address already has an account, so the way forward is signing in rather than
                       resubmitting the form: Severity.Warning plus the two routes out of the dead end.
                       role="alert": the alert only enters the DOM after a failed submit, so nothing
                       announces it unless it arrives as a live region. *@
                    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true" role="alert"
                              data-testid="email-already-registered">
                        @L["Auth.Register.EmailAlreadyRegistered", _rejectedEmail ?? string.Empty]
                        @* Underline.Always: an in-text link must be distinguishable without relying on
                           colour alone (WCAG 2.1 AA / axe link-in-text-block). *@
                        <div class="d-flex flex-wrap mt-1" style="gap: 1rem;">
                            <MudLink Href="/login" Typo="Typo.body2" Underline="Underline.Always">@L["Auth.Register.SignIn"]</MudLink>
                            <MudLink Href="/forgot-password" Typo="Typo.body2" Underline="Underline.Always">@L["Auth.Register.ResetPassword"]</MudLink>
                        </div>
                    </MudAlert>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    @* role="alert": the alert only enters the DOM after a failed submit, so nothing
                       announces it unless it arrives as a live region. *@
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" role="alert">@_errorMessage</MudAlert>
                }
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.FirstName" For="@(() => _model.FirstName)" Label="@L["Auth.Field.FirstName"]"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      autocomplete="given-name" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.LastName" For="@(() => _model.LastName)" Label="@L["Auth.Field.LastName"]"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      autocomplete="family-name" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Email" @bind-Value:after="OnEmailEdited" For="@(() => _model.Email)" Label="@L["Auth.Field.Email"]" InputType="InputType.Email"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      autocomplete="email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Label="@L["Auth.Field.Password"]" InputType="InputType.Password"
                                      Immediate="true"
                                      HelperText="@L["Auth.Register.PasswordHelper"]"
                                      Variant="Variant.Outlined"
                                      autocomplete="new-password" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)" Label="@L["Auth.Field.ConfirmPassword"]" InputType="InputType.Password"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      autocomplete="new-password" />
                    </MudItem>
                </MudGrid>

                @* Offered only when the host collects addresses (RegistrationSettings, on by default):
                   a host whose user model stores no address must not ask for one. *@
                @if (CollectAddress)
                {
                    <MudExpansionPanels Class="mt-4" Elevation="0">
                        <MudExpansionPanel Text="@L["Auth.Register.AddressOptional"]">
                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.AddressLine1" Label="@L["Auth.Field.AddressLine1"]"
                                                  Variant="Variant.Outlined" autocomplete="address-line1" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.AddressLine2" Label="@L["Auth.Field.AddressLine2"]"
                                                  Variant="Variant.Outlined" autocomplete="address-line2" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.City" Label="@L["Auth.Field.City"]"
                                                  Variant="Variant.Outlined" autocomplete="address-level2" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.State" Label="@L["Auth.Field.State"]"
                                                  Variant="Variant.Outlined" autocomplete="address-level1" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.ZipCode" Label="@L["Auth.Field.ZipCode"]"
                                                  Variant="Variant.Outlined" autocomplete="postal-code" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.Country" Label="@L["Auth.Field.Country"]"
                                                  Variant="Variant.Outlined" autocomplete="country-name" />
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                @if (RequiresTerms)
                {
                    @* Rendered only when the host configures a Terms URL (LegalSettings). The document
                       names inside the label are links: clicking one opens the document and does not
                       toggle the box (HTML label activation skips interactive descendants), and the
                       whole sentence stays the checkbox's accessible name. *@
                    <div class="mt-4" data-testid="register-accept-terms">
                        <MudCheckBox T="bool" @bind-Value="_model.AcceptedTerms" Color="Color.Primary" Dense="true">
                            <MudText Typo="Typo.body2" Inline="true">
                                @L["Auth.Register.AcceptTerms.Prefix"]
                                @LegalDocument(Legal.TermsUrl, L["Legal.TermsOfService"])
                                @L["Auth.Register.AcceptTerms.And"]
                                @LegalDocument(Legal.PrivacyUrl, L["Legal.PrivacyPolicy"])
                                @if (!string.IsNullOrWhiteSpace(Legal.CodeOfConductUrl))
                                {
                                    @L["Auth.Register.AcceptTerms.CodeOfConductPrefix"]
                                    @LegalDocument(Legal.CodeOfConductUrl, L["Legal.CodeOfConduct"])
                                }
                            </MudText>
                        </MudCheckBox>
                    </div>
                }
            </MudCardContent>
            <MudCardActions Class="d-flex flex-column pa-6 pt-2" Style="gap: 0.75rem;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="@(_isLoading || (RequiresTerms && !_model.AcceptedTerms))" ButtonType="ButtonType.Submit" Size="Size.Large"
                           aria-busy="@(_isLoading ? "true" : "false")"
                           aria-label="@L["Auth.Register.CreateAccount.Aria"]">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Auth.Register.CreateAccount"]
                </MudButton>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    @L["Auth.Register.AlreadyHaveAccount"]
                    @* Underline.Always: an in-text link must be distinguishable without relying on colour
                       alone (WCAG 2.1 AA / axe link-in-text-block). *@
                    <MudLink Href="/login" Typo="Typo.body2" Underline="Underline.Always">@L["Auth.Register.SignIn"]</MudLink>
                </MudText>
            </MudCardActions>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    private readonly RegisterModel _model = new();
    private string? _errorMessage;
    private string? _rejectedEmail; // The duplicate-email rule is documented at the alert markup.
    private bool _isLoading;

    private void OnEmailEdited() =>
        _rejectedEmail = string.Equals(_model.Email, _rejectedEmail, StringComparison.Ordinal) ? _rejectedEmail : null;

    private LegalSettings Legal => LegalOptions.Value;

    // The host opted into terms acceptance by publishing a Terms URL; the server stamps its own
    // configured version, so the page only sends whether the box was ticked.
    private bool RequiresTerms => !string.IsNullOrWhiteSpace(Legal.TermsUrl);

    // A document name inside the agreement sentence: a link when the host published that document,
    // plain text when it did not (the sentence still names it).
    private static RenderFragment LegalDocument(string url, string name) => builder =>
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            builder.AddContent(0, name);
            return;
        }

        builder.OpenComponent<ExternalLink>(1);
        builder.AddComponentParameter(2, nameof(ExternalLink.Href), url);
        builder.AddComponentParameter(3, nameof(ExternalLink.Underline), Underline.Always);
        builder.AddComponentParameter(4, nameof(ExternalLink.ChildContent), (RenderFragment)(content => content.AddContent(5, name)));
        builder.CloseComponent();
    };

    private async Task HandleRegisterAsync()
    {
        // Field-level rules (required, email, password complexity, password match) are enforced by the
        // EditForm + DataAnnotations before OnValidSubmit fires; this method only handles the call and
        // any server-side failure, surfaced in the form-level MudAlert.
        _errorMessage = null;
        _rejectedEmail = null;

        // The disabled submit button is the primary guard; this covers a submit that arrives anyway
        // (Enter in a field while the button state is stale).
        if (RequiresTerms && !_model.AcceptedTerms)
        {
            _errorMessage = L["Auth.Register.AcceptTerms.Required"];
            return;
        }

        var addressResult = BuildAddressResult();
        if (addressResult is { IsFailure: true } failedAddress)
        {
            _errorMessage = failedAddress.Errors[0].Message;
            return;
        }

        _isLoading = true;

        var submittedEmail = _model.Email; // The field stays editable while the request is in flight.

        try
        {
            var result = await AuthService.RegisterAsync(
                new RegisterRequest(
                    submittedEmail,
                    _model.Password,
                    _model.FirstName,
                    _model.LastName,
                    addressResult?.Value,
                    AcceptedTerms: RequiresTerms && _model.AcceptedTerms));
            if (result.IsFailure)
            {
                // The duplicate-address conflict is the one failure with a next step of its own: the
                // account exists, so the user is pointed at sign-in or password reset rather than at a
                // red alert that invites a retry. Matched on the code, never on the wording.
                if (result.Errors.Any(e => string.Equals(e.Code, AuthErrorCodes.EmailAlreadyExists, StringComparison.Ordinal)))
                {
                    _rejectedEmail = submittedEmail;
                    OnEmailEdited(); // An edit made while the request was in flight dismisses it at once.
                    return;
                }

                _errorMessage = result.LocalizedErrorMessage(L) ?? L["Auth.Register.Failed"];
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            _errorMessage = L["Auth.Register.GenericError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
