@page "/reset-password"
@using MMCA.Common.UI.Common
@using Microsoft.Extensions.DependencyInjection
@using MMCA.Common.UI.Services.Auth
@using MMCA.Common.UI.Services.Capabilities
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(false)]
@inject IAuthUIService AuthService
@inject IServiceProvider Services
@inject IStringLocalizer<SharedResource> L
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.Reset.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="auth-container">
    <div class="d-flex flex-column align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Large"
                 Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.h4" Align="Align.Center">@L["Auth.Reset.Title"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @L["Auth.Reset.Subtitle"]
        </MudText>
    </div>

    <MudCard Elevation="1">
        @if (_isCompleted)
        {
            <MudCardContent Class="pa-6">
                <MudAlert Severity="Severity.Success" Dense="true">@L["Auth.Reset.Success"]</MudAlert>
            </MudCardContent>
            <MudCardActions Class="d-flex flex-column pa-6 pt-0" Style="gap: 0.75rem;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Href="/login" Size="Size.Large">
                    @L["Auth.Reset.GoToLogin"]
                </MudButton>
            </MudCardActions>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleResetAsync">
                <DataAnnotationsValidator />
                <MudCardContent Class="pa-6">
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_errorMessage</MudAlert>
                    }
                    <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="@L["Auth.Field.Email"]" InputType="InputType.Email"
                                  Immediate="true"
                                  Variant="Variant.Outlined" Class="mb-4"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  autocomplete="email" />
                    @* The token field stays visible and editable even when the link prefilled it: the
                       email also carries the raw token, which is the only entry path on a native head
                       that cannot follow the deep link. *@
                    <MudTextField @bind-Value="_model.Token" For="@(() => _model.Token)" Label="@L["Auth.Reset.TokenLabel"]"
                                  Immediate="true"
                                  Variant="Variant.Outlined" Class="mb-4"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Key"
                                  autocomplete="one-time-code" />
                    <MudTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)" Label="@L["Auth.Reset.NewPassword"]" InputType="InputType.Password"
                                  Immediate="true"
                                  HelperText="@L["Auth.Register.PasswordHelper"]"
                                  Variant="Variant.Outlined" Class="mb-4"
                                  autocomplete="new-password" />
                    <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)" Label="@L["Auth.Reset.ConfirmPassword"]" InputType="InputType.Password"
                                  Immediate="true"
                                  Variant="Variant.Outlined" Class="mb-2"
                                  autocomplete="new-password" />
                </MudCardContent>
                <MudCardActions Class="d-flex flex-column pa-6 pt-0" Style="gap: 0.75rem;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@_isLoading" ButtonType="ButtonType.Submit" Size="Size.Large"
                               aria-label="@L["Auth.Reset.Submit.Aria"]">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @L["Auth.Reset.Submit"]
                    </MudButton>
                    <MudDivider Class="my-1" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                               Href="/login" Size="Size.Medium">
                        @L["Auth.Reset.GoToLogin"]
                    </MudButton>
                </MudCardActions>
            </EditForm>
        }
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordModel _model = new();
    private string? _errorMessage;
    private bool _isCompleted;
    private bool _isLoading;

    // Prefill from the emailed link. Only fills empty fields, so a user who corrected a value by hand
    // does not have it overwritten when the component's parameters are set again.
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_model.Email) && !string.IsNullOrWhiteSpace(Email))
        {
            _model.Email = Email;
        }

        if (string.IsNullOrWhiteSpace(_model.Token) && !string.IsNullOrWhiteSpace(Token))
        {
            _model.Token = Token;
        }
    }

    // SECURITY: the emailed link carries the address and the single-use token in the URL FRAGMENT,
    // which browsers never send to a server, so the live token stays out of ingress access logs and
    // request telemetry. It can only be read from JS, and reading it also scrubs it from the address
    // bar and the history entry. The query-string parameters above still work, so a link sent before
    // this shipped keeps functioning.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var module = Services.GetService<CapabilitiesJsModule>();
        if (module is null)
        {
            return;
        }

        var fragment = await module.InvokeOrDefaultAsync<string?>("locationHashTake", [], CancellationToken.None);
        if (string.IsNullOrWhiteSpace(fragment))
        {
            return;
        }

        var changed = false;
        foreach (var pair in fragment.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=', StringComparison.Ordinal);
            if (separator <= 0)
            {
                continue;
            }

            var name = pair[..separator];
            var value = Uri.UnescapeDataString(pair[(separator + 1)..]);

            if (string.Equals(name, "email", StringComparison.Ordinal) && string.IsNullOrWhiteSpace(_model.Email))
            {
                _model.Email = value;
                changed = true;
            }
            else if (string.Equals(name, "token", StringComparison.Ordinal) && string.IsNullOrWhiteSpace(_model.Token))
            {
                _model.Token = value;
                changed = true;
            }
        }

        if (changed)
        {
            StateHasChanged();
        }
    }

    private async Task HandleResetAsync()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.ResetPasswordAsync(_model.Email, _model.Token, _model.NewPassword);
            if (result.IsSuccess)
            {
                _isCompleted = true;
            }
            else
            {
                _errorMessage = result.LocalizedErrorMessage(L) ?? L["Auth.Reset.GenericError"];
            }
        }
        catch
        {
            _errorMessage = L["Auth.Reset.GenericError"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
