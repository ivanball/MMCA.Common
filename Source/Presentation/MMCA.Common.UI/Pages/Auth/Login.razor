@page "/login"
@using MMCA.Common.UI.Validation
@using Microsoft.Extensions.Options
@using MMCA.Common.Shared.Auth.Requests
@using MMCA.Common.UI.Common
@using MMCA.Common.UI.Common.Settings
@using MMCA.Common.UI.Services.Auth
@using MMCA.Common.UI.Services.Auth.OAuth
@using MMCA.Common.UI.Services.Capabilities.Auth
@using MMCA.Common.UI.Services.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(false)]
@inject IAuthUIService AuthService
@inject OAuthFlowStateStore OAuthFlowState
@inject IOAuthUISettings OAuthSettings
@inject IOptions<ApiSettings> ApiSettingsOptions
@inject NavigationManager Navigation
@inject IUserPreferenceReader PreferenceReader
@inject ICultureApplier CultureApplier
@inject ThemeService ThemeService
@inject IExternalAuthBroker ExternalAuthBroker
@inject IOptions<SignInSettings> SignInOptions
@inject IServiceProvider Services
@inject IStringLocalizer<SharedResource> L
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.Login.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="auth-container">
    <div class="d-flex flex-column align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large"
                 Color="Color.Primary" Class="mb-2" />
        @* HtmlTag="h1": the page's required level-one heading, and what FocusOnNavigate targets. *@
        <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">@L["Auth.Login.WelcomeBack"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @L["Auth.Login.Subtitle"]
        </MudText>
    </div>

    <MudCard Elevation="1">
        <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
            <LocalizedDataAnnotationsValidator />
            <MudCardContent Class="pa-6">
                @if (_existingAccountEmail is not null)
                {
                    @* Registration sent the visitor here because the address already has an account,
                       so the next steps are signing in, resetting the password, or a sign-in link. A
                       status, not an alert: arriving here is the expected path, not a failure. *@
                    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true" role="status"
                              data-testid="login-existing-account">
                        @L["Auth.Login.ExistingAccount", _existingAccountEmail]
                        <div class="d-flex flex-wrap mt-2 mmca-auth-links">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       OnClick="OpenPasswordReset" data-testid="login-reset-password">
                                @L["Auth.Login.ResetPassword"]
                            </MudButton>
                        </div>
                    </MudAlert>
                }
                @if (_signInLinkSentTo is not null)
                {
                    @* Worded as "if an account exists": the endpoint answers 202 either way. *@
                    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true" role="status" aria-live="polite"
                              data-testid="login-sign-in-link-sent">
                        @L["Auth.Login.SignInLinkSent", _signInLinkSentTo]
                    </MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    @* role="alert": the alert only enters the DOM after a failed submit, so nothing
                       announces it unless it arrives as a live region. *@
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" role="alert">@_errorMessage</MudAlert>
                }
                <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="@L["Auth.Field.Email"]" InputType="InputType.Email"
                              Immediate="true"
                              Variant="Variant.Outlined" Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              autocomplete="email" />
                <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Label="@L["Auth.Field.Password"]" InputType="InputType.Password"
                              Immediate="true"
                              Variant="Variant.Outlined" Class="mb-2"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Key"
                              autocomplete="current-password" />
            </MudCardContent>
            <MudCardActions Class="d-flex flex-column pa-6 pt-0 mmca-auth-actions">
                @* aria-busy is spelled out as a string, never a bool: Blazor renders a false bool
                   attribute away entirely and a true one as aria-busy="", and the empty value is not
                   one of the two this attribute accepts. Same treatment on every submit button in
                   the shared auth pages. *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="@_isLoading" ButtonType="ButtonType.Submit" Size="Size.Large"
                           aria-busy="@(_isLoading ? "true" : "false")"
                           aria-label="@L["Auth.Login.SignIn.Aria"]">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @L["Auth.Login.SignIn"]
                </MudButton>
                @* Underline.Always: the recovery link must be distinguishable without relying on
                   colour alone (WCAG 2.1 AA / axe link-in-text-block), same rule as Register.razor. *@
                <MudLink Href="/forgot-password" Typo="Typo.body2" Underline="Underline.Always"
                         Class="align-self-center">@L["Auth.Login.ForgotPassword"]</MudLink>
                @if (SignInOptions.Value.OfferSignInLink)
                {
                    @* Opt-in (SignInSettings.OfferSignInLink, ADR-116): a one-time link to the typed
                       address instead of a password. *@
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               Disabled="@_isSendingLink" OnClick="SendSignInLinkAsync" Size="Size.Medium"
                               StartIcon="@Icons.Material.Filled.MarkEmailRead"
                               aria-busy="@(_isSendingLink ? "true" : "false")"
                               data-testid="login-email-sign-in-link">
                        @L["Auth.Login.EmailMeLink"]
                    </MudButton>
                }
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    @L["Auth.Login.NoAccount"]
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           Href="/register" Size="Size.Medium">
                    @L["Auth.Login.CreateAccount"]
                </MudButton>
                @if (_hasExternalProviders)
                {
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        @L["Auth.Login.OrContinueWith"]
                    </MudText>
                    @* Native heads route external sign-in through the system-browser broker
                       (ADR-043); web heads redirect from a button that mints the per-attempt
                       state on click (Login.razor.cs). Apple renders first:
                       App Store guideline 4.8 requires Sign in with Apple as an equivalent
                       option wherever third-party login is offered, and Apple's HIG asks for
                       at least equal prominence. *@
                    @if (OAuthSettings.AppleEnabled)
                    {
                        @if (ExternalAuthBroker.IsAvailable)
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.Apple"
                                       OnClick="@(() => SignInWithBrokerAsync("apple"))"
                                       aria-label="@L["Auth.Login.SignInWithApple"]">
                                @L["Auth.Login.SignInWithApple"]
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.Apple"
                                       OnClick="@(() => SignInWithRedirectAsync("apple"))"
                                       Disabled="@_externalSignInUnavailable"
                                       aria-label="@L["Auth.Login.SignInWithApple"]">
                                @L["Auth.Login.SignInWithApple"]
                            </MudButton>
                        }
                    }
                    @if (OAuthSettings.GoogleEnabled)
                    {
                        @if (ExternalAuthBroker.IsAvailable)
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.Google"
                                       OnClick="@(() => SignInWithBrokerAsync("google"))"
                                       aria-label="@L["Auth.Login.SignInWithGoogle"]">
                                @L["Auth.Login.SignInWithGoogle"]
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.Google"
                                       OnClick="@(() => SignInWithRedirectAsync("google"))"
                                       Disabled="@_externalSignInUnavailable"
                                       aria-label="@L["Auth.Login.SignInWithGoogle"]">
                                @L["Auth.Login.SignInWithGoogle"]
                            </MudButton>
                        }
                    }
                    @if (OAuthSettings.GitHubEnabled)
                    {
                        @if (ExternalAuthBroker.IsAvailable)
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.GitHub"
                                       OnClick="@(() => SignInWithBrokerAsync("github"))"
                                       aria-label="@L["Auth.Login.SignInWithGitHub"]">
                                @L["Auth.Login.SignInWithGitHub"]
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Medium"
                                       StartIcon="@Icons.Custom.Brands.GitHub"
                                       OnClick="@(() => SignInWithRedirectAsync("github"))"
                                       Disabled="@_externalSignInUnavailable"
                                       aria-label="@L["Auth.Login.SignInWithGitHub"]">
                                @L["Auth.Login.SignInWithGitHub"]
                            </MudButton>
                        }
                    }
                }
            </MudCardActions>
        </EditForm>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _hasExternalProviders;
    private string _apiBase = string.Empty;

    protected override void OnInitialized()
    {
        _hasExternalProviders = OAuthSettings.AppleEnabled || OAuthSettings.GoogleEnabled || OAuthSettings.GitHubEnabled;
        _apiBase = ApiSettingsOptions.Value.ApiEndpoint?.TrimEnd('/') ?? string.Empty;
        _errorMessage = ExternalSignInErrorMessage(Error);
        ApplyHandedOverEmail();
    }

    private string BuildOAuthUrl(string provider, string? oauthState)
    {
        var url = $"{_apiBase}/auth/oauth/{provider}";
        var safeReturnUrl = ReturnUrlProtector.Sanitize(ReturnUrl, "/");
        var query = new List<string>();
        if (!string.Equals(safeReturnUrl, "/", StringComparison.Ordinal))
        {
            query.Add($"returnUrl={Uri.EscapeDataString(safeReturnUrl)}");
        }

        if (!string.IsNullOrEmpty(oauthState))
        {
            query.Add($"state={Uri.EscapeDataString(oauthState)}");
        }

        return query.Count == 0 ? url : $"{url}?{string.Join("&", query)}";
    }

    private async Task SignInWithBrokerAsync(string provider)
    {
        _errorMessage = null;

        // On success the broker hands off to the shared completion page, which finishes the
        // sign-in. A false result covers dismissal and provider failure alike.
        if (!await ExternalAuthBroker.SignInAsync(provider))
        {
            _errorMessage = L["Auth.Login.ExternalSignInFailed"].Value;
            StateHasChanged();
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            // The service reports every outcome as a Result, so the only catch left is for a
            // genuine fault in the navigation/preference tail below.
            var result = await AuthService.LoginAsync(new LoginRequest(_model.Email, _model.Password), _cts.LifetimeToken());
            if (result.IsFailure)
            {
                _errorMessage = PasswordLoginErrorMessage(result);
                return;
            }

            await ApplyStoredPreferencesAndNavigateAsync(ReturnUrlProtector.Sanitize(ReturnUrl, "/"));
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // Expected during component disposal or an InteractiveAuto render-mode transition.
        }
        catch
        {
            _errorMessage = L["Auth.Login.GenericError"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Applies the signed-in user's stored culture/theme (ADR-027/028) once, right after login, so the
    // preference follows them across devices. Best-effort: an empty/failed read just navigates normally.
    // Loop-free because this only runs on the explicit login action.
    private async Task ApplyStoredPreferencesAndNavigateAsync(string destination)
    {
        var preferences = await PreferenceReader.GetAsync();

        if (preferences.Theme is not null)
        {
            await ThemeService.SetDarkModeAsync(string.Equals(preferences.Theme, "dark", StringComparison.OrdinalIgnoreCase));
        }

        if (preferences.Culture is not null
            && !string.Equals(preferences.Culture, System.Globalization.CultureInfo.CurrentUICulture.Name, StringComparison.OrdinalIgnoreCase))
        {
            // The applier owns both the switch and landing on the destination, so this is terminal:
            // the web head round-trips /culture/set to write the cookie, a MAUI head switches the
            // process culture in place and reloads the WebView (ADR-027).
            await CultureApplier.ApplyAsync(preferences.Culture, destination);
            return;
        }

        Navigation.NavigateTo(destination, forceLoad: true);
    }
}
