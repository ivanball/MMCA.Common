@page "/forgot-password"
@using MMCA.Common.UI.Validation
@using MMCA.Common.UI.Services.Auth
@using MMCA.Common.UI.Services.Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(false)]
@inject IAuthUIService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@attribute [AllowAnonymous]

<PageTitle>@L["Auth.Forgot.PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="auth-container">
    <div class="d-flex flex-column align-center mb-6">
        <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large"
                 Color="Color.Primary" Class="mb-2" />
        @* HtmlTag="h1": the page's required level-one heading, and what FocusOnNavigate targets. *@
        <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">@L["Auth.Forgot.Title"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @L["Auth.Forgot.Subtitle"]
        </MudText>
    </div>

    <MudCard Elevation="1">
        @if (_isSubmitted)
        {
            <MudCardContent Class="pa-6">
                <MudAlert Severity="Severity.Success" Dense="true">@L["Auth.Forgot.Confirmation"]</MudAlert>
            </MudCardContent>
            <MudCardActions Class="d-flex flex-column pa-6 pt-0 mmca-auth-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           Href="/login" Size="Size.Medium">
                    @L["Auth.Forgot.BackToLogin"]
                </MudButton>
            </MudCardActions>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleRequestAsync">
                <LocalizedDataAnnotationsValidator />
                <MudCardContent Class="pa-6">
                    <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="@L["Auth.Field.Email"]" InputType="InputType.Email"
                                  Immediate="true"
                                  Variant="Variant.Outlined" Class="mb-2"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  autocomplete="email" />
                </MudCardContent>
                <MudCardActions Class="d-flex flex-column pa-6 pt-0 mmca-auth-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@_isLoading" ButtonType="ButtonType.Submit" Size="Size.Large"
                               aria-busy="@(_isLoading ? "true" : "false")">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @L["Auth.Forgot.Submit"]
                    </MudButton>
                    <MudDivider Class="my-1" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                               Href="/login" Size="Size.Medium">
                        @L["Auth.Forgot.BackToLogin"]
                    </MudButton>
                </MudCardActions>
            </EditForm>
        }
    </MudCard>
</MudContainer>

@code {
    private readonly ForgotPasswordModel _model = new();
    private bool _isSubmitted;
    private bool _isLoading;

    // Sign-in hands the address over in history state (never the URL), so the visitor does not
    // type it twice.
    protected override void OnInitialized() =>
        _model.Email = AuthEmailPrefill.Read(Navigation, out _) ?? _model.Email;

    // Anti-enumeration: the page switches to the confirmation state for every submitted address,
    // whatever the API answered (and even if the call threw). A distinguishable outcome here would
    // leak which addresses have accounts, defeating the always-202 contract the endpoint upholds.
    // The returned Result is therefore deliberately not inspected: this is the one page where a
    // failure must look exactly like a success.
    private async Task HandleRequestAsync()
    {
        _isLoading = true;

        try
        {
            await AuthService.RequestPasswordResetAsync(_model.Email);
        }
        catch
        {
            // Swallowed on purpose: see the anti-enumeration note above.
        }
        finally
        {
            _isLoading = false;
            _isSubmitted = true;
        }
    }
}
