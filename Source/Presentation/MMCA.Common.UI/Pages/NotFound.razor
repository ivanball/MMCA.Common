@page "/not-found"
@using Microsoft.AspNetCore.Authorization
@layout MainLayout
@inject IStringLocalizer<SharedResource> L
@inject IEnumerable<MMCA.Common.UI.Common.Interfaces.IUIModule> UIModules
@inject MMCA.Common.UI.Services.Navigation.IForbiddenReExecutionDetector ForbiddenReExecution
@attribute [AllowAnonymous]

@* Hosts re-execute error statuses to this route (UseStatusCodePagesWithReExecute("/not-found")), so a
   full page load the server answered with 403 (a signed-in user lacking the permission) also lands
   here, with the original status still on the response. That request renders the Access Denied view
   of Forbidden under its 403; a 404, and an interactive render with no request to read, render Page
   Not Found. Only a server render can read the status, so IForbiddenReExecutionDetector answers: the
   Blazor Web host (MMCA.Common.UI.Web) registers the request-reading implementation, and every other
   head keeps the shared default, which always answers false. *@
@if (IsForbiddenReExecution)
{
    <Forbidden />
}
else
{
    <PageTitle>@L["Page.NotFound.Title"]</PageTitle>

    @* An app's own not-found content (IUIModule.NotFoundContentType) replaces the default below. *@
    @if (AppNotFoundContentType is { } contentType)
    {
        <DynamicComponent Type="contentType" />
    }
    else
    {
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center mt-16">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large"
                     Color="Color.Secondary" Class="mb-4 mmca-status-icon" />
            <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center" Class="mb-2">@L["Page.NotFound.Title"]</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
                @L["Page.NotFound.Message"]
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Home"
                       Href="/" Size="Size.Large">
                @L["Page.BackToHome"]
            </MudButton>
        </MudContainer>
    }
}

@code {
    /// <summary>The first module-supplied not-found content, or <see langword="null"/> for the framework's own.</summary>
    private Type? AppNotFoundContentType => UIModules.Select(module => module.NotFoundContentType).FirstOrDefault(type => type is not null);

    /// <summary>
    /// True when this render answers a request whose status is already 403: status-code-pages
    /// re-execution keeps the original status on the response, which only the server host can read.
    /// </summary>
    private bool IsForbiddenReExecution => ForbiddenReExecution.IsForbiddenReExecution;
}
