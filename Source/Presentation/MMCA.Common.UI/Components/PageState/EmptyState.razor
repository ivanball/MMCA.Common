@inject IStringLocalizer<SharedResource> L

<div class="d-flex flex-column align-center justify-center pa-8 mmca-empty-state">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" Class="mb-3 mmca-empty-state-icon" />
    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Align="Align.Center" Class="mmca-empty-state-text">@(Message ?? L["Common.EmptyState.NoRecords"])</MudText>
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.SearchOff;

    /// <summary>Empty-state text; defaults to the localized "No records found." (ADR-027).</summary>
    [Parameter] public string? Message { get; set; }
}
