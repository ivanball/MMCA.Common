@inject IStringLocalizer<SharedResource> L
@inject IDialogService DialogService

@code {
    // A confirmation before something irreversible, in ConfirmationDialog's shape: Cancel first and
    // focused, Escape backs out (ShowAsync returns null), the Delete button in the error color.

    // The data-testid of the Delete button, which the E2E confirm helpers target.
    private const string ConfirmTestId = "confirm-delete";

    /// <summary>
    /// Display name of the entity being deleted. Pass a LOCALIZED noun (e.g. <c>L["EntityName"]</c> from
    /// the page's own resources, ADR-027); defaults to the localized generic "item".
    /// </summary>
    [Parameter] public string? EntityType { get; set; }

    private string DisplayEntityType => EntityType ?? L["Delete.Entity.Item"];

    /// <summary>
    /// Opens the delete confirmation for <paramref name="entityName"/>.
    /// </summary>
    /// <param name="entityName">The name of the entity being deleted, shown in the prompt.</param>
    /// <returns><see langword="true"/> when the user confirmed; <see langword="null"/> when they cancelled or dismissed it.</returns>
    public async Task<bool?> ShowAsync(string? entityName)
    {
        var entityType = DisplayEntityType;
        var confirmed = await ConfirmationDialog.ShowAsync(
            DialogService,
            L["Delete.Title", entityType],
            L["Delete.Message", entityType.ToLower(System.Globalization.CultureInfo.CurrentUICulture), entityName ?? string.Empty],
            L["Delete.Confirm"],
            L["Common.Button.Cancel"],
            destructive: true,
            ConfirmTestId);

        return confirmed ? true : null;
    }
}
