@inject IStringLocalizer<SharedResource> L
@inject IDialogService DialogService

@code {
    // A confirmation before something irreversible: Escape backs out (MudBlazor resolves it as Cancel,
    // so ShowAsync returns null). Initial focus on Cancel comes from DeleteConfirmationDialog's own focus trap.
    private static readonly DialogOptions ConfirmationDialogOptions = new()
    {
        CloseOnEscapeKey = true
    };

    /// <summary>
    /// Display name of the entity being deleted. Pass a LOCALIZED noun (e.g. <c>L["EntityName"]</c> from
    /// the page's own resources, ADR-027); defaults to the localized generic "item".
    /// </summary>
    [Parameter] public string? EntityType { get; set; }

    private string DisplayEntityType => EntityType ?? L["Delete.Entity.Item"];

    /// <summary>
    /// Opens the delete confirmation for <paramref name="entityName"/>.
    /// </summary>
    /// <param name="entityName">The name of the entity being deleted, shown in the prompt.</param>
    /// <returns><see langword="true"/> when the user confirmed; <see langword="null"/> when they cancelled or dismissed it.</returns>
    public async Task<bool?> ShowAsync(string? entityName)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { dialog => dialog.EntityType, DisplayEntityType },
            { dialog => dialog.EntityName, entityName }
        };

        var reference = await DialogService.ShowAsync<DeleteConfirmationDialog>(
            title: null,
            parameters,
            ConfirmationDialogOptions);
        var result = await reference.Result;

        return result is null || result.Canceled || result.Data is not bool confirmed ? null : confirmed;
    }
}
