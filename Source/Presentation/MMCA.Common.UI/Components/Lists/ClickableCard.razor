@* The card body of MobileInfiniteScrollList. A card that carries a click
   callback is an interactive control, so it is announced as one (role="button"), reachable by
   keyboard (tabindex="0") and operable by keyboard (Enter and Space), which is what a bare @onclick
   on a <div> is not (WCAG 2.1.1 / 4.1.2). A card with no callback renders as plain content with no
   tabindex and no role, so a read-only list does not fill the tab order with non-actions.

   Enter/Space do not preventDefault: a keydown handler that cancelled the default would also cancel
   Tab, which would trap the keyboard inside the list. The cost is that Space still scrolls the page
   as well as activating the card; the requirement is operability, and that is met.

   The content sits in a wrapper that stops keydown propagation, so Enter or Space pressed on a
   control nested inside the card (a delete button, a link) never activates the card as well; a
   keydown that starts on the focused card element itself does not pass through the wrapper.

   The card is always named by its own content: there is deliberately no aria-label override, since
   any label that replaced the visible text would fail WCAG 2.5.3 (Label in Name, axe
   label-content-name-mismatch).

   Actions (a delete or edit button) go in the Actions slot, never in ChildContent: a control
   nested inside a role="button" element is axe nested-interactive. With Actions supplied, the
   button role, tabindex and the click and key handlers move from the card onto a wrapper around
   the body alone, and the actions render after it as its sibling, so a tap on an action never
   activates the card. Without Actions the markup is the original one-element card. *@
@if (IsInteractive && Actions is not null)
{
    <MudCard Elevation="@Elevation" Class="@Class">
        <MudCardContent Class="pa-3">
            <div class="mobile-list-card-activator" tabindex="0" role="button"
                 @onclick="ActivateAsync" @onkeydown="OnKeyDownAsync">
                <div class="mobile-list-card-body" @onkeydown:stopPropagation>@ChildContent</div>
            </div>
            <div class="mobile-list-card-actions">@Actions</div>
        </MudCardContent>
    </MudCard>
}
else if (IsInteractive)
{
    <MudCard Elevation="@Elevation" Class="@Class" tabindex="0" role="button"
             @onclick="ActivateAsync" @onkeydown="OnKeyDownAsync">
        <MudCardContent Class="pa-3">
            <div class="mobile-list-card-body" @onkeydown:stopPropagation>@ChildContent</div>
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Elevation="@Elevation" Class="@Class">
        <MudCardContent Class="pa-3">
            @ChildContent
            @if (Actions is not null)
            {
                <div class="mobile-list-card-actions">@Actions</div>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    /// <summary>The card body.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional interactive controls for the card (a delete or edit button). They render after the
    /// body and outside the element that carries the card's button role, so they are never nested
    /// inside it (axe nested-interactive) and activating one does not activate the card.
    /// </summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Raised when the card is activated by click, Enter or Space. Leave it unset to render a
    /// non-interactive card.
    /// </summary>
    [Parameter] public EventCallback OnActivate { get; set; }

    /// <summary>Card elevation; matches the list components' own default.</summary>
    [Parameter] public int Elevation { get; set; } = 1;

    /// <summary>CSS classes applied to the card.</summary>
    [Parameter] public string Class { get; set; } = "mobile-list-card";

    /// <summary>
    /// Whether this card behaves as a control. Driven by <see cref="EventCallback.HasDelegate"/>, so
    /// a list that never wired a click callback stays out of the tab order entirely.
    /// </summary>
    private bool IsInteractive => OnActivate.HasDelegate;

    private Task ActivateAsync() => OnActivate.InvokeAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        // " " is the modern key value for Space; "Spacebar" is the legacy one still emitted by some
        // assistive-technology virtual cursors.
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            return OnActivate.InvokeAsync();
        }

        return Task.CompletedTask;
    }
}
