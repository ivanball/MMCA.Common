@using MMCA.Common.Shared.Auth.Responses

@if (SignIns.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.History" Message="@L["Auth.SignIns.Empty"]" />
}
else
{
    @* Read-only: the sign-out controls live on the signed-in devices list, which acts on live
       sessions only. role="region" names the table's wrapper div, which MudTable splats unmatched
       attributes onto. *@
    <MudTable Items="SignIns" T="SignInSummaryResponse" Hover="true" Elevation="1"
              Breakpoint="Breakpoint.Sm" Class="mmca-auth-table"
              role="region" aria-label="@L["Auth.SignIns.TableLabel"]">
        <HeaderContent>
            <MudTh>@L["Auth.Sessions.Column.Device"]</MudTh>
            <MudTh>@L["Auth.Sessions.Column.IpAddress"]</MudTh>
            <MudTh>@L["Auth.Sessions.Column.SignedIn"]</MudTh>
            <MudTh>@L["Auth.SignIns.Column.LastActive"]</MudTh>
            <MudTh>@L["Auth.SignIns.Column.Status"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Auth.Sessions.Column.Device"]">
                @DescribeDevice(context)
                @if (context.IsCurrent)
                {
                    @* Text, not a colour-only marker (WCAG 1.4.1). *@
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                             Class="ml-2 mmca-current-sign-in">@L["Auth.SignIns.Current"]</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="@L["Auth.Sessions.Column.IpAddress"]">@DescribeIpAddress(context)</MudTd>
            <MudTd DataLabel="@L["Auth.Sessions.Column.SignedIn"]">@FormatInstant(context.StartedAt)</MudTd>
            <MudTd DataLabel="@L["Auth.SignIns.Column.LastActive"]">@FormatInstant(context.LastActiveAt)</MudTd>
            <MudTd DataLabel="@L["Auth.SignIns.Column.Status"]">
                <span class="mmca-sign-in-status">@DescribeStatus(context)</span>
                @if (context.EndedAt is { } endedAt)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@FormatInstant(endedAt)</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}
