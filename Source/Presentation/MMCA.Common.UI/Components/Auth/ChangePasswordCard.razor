@using MMCA.Common.UI.Services.Auth
@inject IAuthUIService AuthService
@inject IToastService Toast
@inject IStringLocalizer<ChangePasswordCard> L
@implements IDisposable

@* The change-password body of a profile page: current, new and confirm fields with the required,
   min-length and match validators, the per-form ErrorSummary, and the submit button. It renders a
   MudCardContent plus MudCardActions pair, so the page keeps its own MudCard, heading and layout and
   places this inside them. *@
<MudCardContent>
    <MudForm @ref="_passwordForm">
        <MudTextField @bind-Value="_currentPassword" Label="@L["ChangePassword.Current"].Value"
                      InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4"
                      Required="true" RequiredError="@L["ChangePassword.CurrentRequired"].Value" />
        <MudTextField @bind-Value="_newPassword" Label="@L["ChangePassword.New"].Value"
                      InputType="InputType.Password" Variant="Variant.Outlined"
                      HelperText="@L.Plural("ChangePassword.NewHelper", MinLength, MinLength).Value" Class="mb-4"
                      Required="true" RequiredError="@L["ChangePassword.NewRequired"].Value"
                      MaxLength="@(MaxLength ?? NoMaxLength)"
                      Validation="@(new Func<string, string?>(ValidateNewPassword))" />
        <MudTextField @bind-Value="_confirmNewPassword" Label="@L["ChangePassword.Confirm"].Value"
                      InputType="InputType.Password" Variant="Variant.Outlined"
                      Required="true" RequiredError="@L["ChangePassword.ConfirmRequired"].Value"
                      Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />
    </MudForm>

    @* One deduplicating, localized block for the form's validation messages. *@
    <ErrorSummary Messages="_passwordForm?.Errors" Localizer="L"
                  Title="@L["Validation.CorrectFollowing"].Value"
                  Variant="Variant.Outlined" Class="mt-4" />
</MudCardContent>
<MudCardActions>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               Disabled="_isSaving" OnClick="SavePasswordAsync">
        @(_isSaving ? L["Button.Saving"] : L["Button.ChangePassword"])
    </MudButton>
    @AdditionalActions
</MudCardActions>
