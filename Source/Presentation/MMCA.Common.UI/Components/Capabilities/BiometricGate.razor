@using Microsoft.Extensions.Logging
@using MMCA.Common.UI.Services.Auth.Tokens
@using MMCA.Common.UI.Services.Capabilities.Auth
@using MMCA.Common.UI.Services.Capabilities.DeviceStatus
@using MMCA.Common.UI.Services.Capabilities.DeviceStorage
@inject IBiometricAuthenticator Biometrics
@inject IDevicePreferences Preferences
@inject ITokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject IAppLifecycleNotifier AppLifecycle
@inject ILogger<BiometricGate> Logger
@implements IDisposable
@inject IStringLocalizer<BiometricGate> L

@* App-lock overlay (ADR-042 Wave 4). Rendered once per app start through the IUIModule
   layout-component list; when the opt-in preference (DevicePreferenceKeys.AppLockEnabled) is set
   and stored tokens exist, it blocks the UI until the platform prompt verifies the owner.
   Declining offers sign-out (clears tokens); it never falls through to the signed-in session. *@

@if (_locked)
{
    @* MudFocusTrap makes the overlay a real boundary rather than a picture of one: without it Tab
       walks straight out of the panel and onto the page underneath, which is still fully focusable
       behind the dark backdrop (WCAG 2.4.3, and a genuine app-lock defect rather than a cosmetic
       one). DefaultFocus.FirstChild lands on Unlock, the only action this panel exists to offer;
       the explicit focus below restores it after a declined platform prompt. *@
    <MudOverlay Visible="true" DarkBackground="true" Style="z-index: 2000;">
        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
            <MudPaper Class="pa-6 d-flex flex-column align-center gap-3" Elevation="4">
                <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["Title"]</MudText>
                <MudButton @ref="_unlockButton" Variant="Variant.Filled" Color="Color.Primary" OnClick="UnlockAsync">
                    @L["Button.Unlock"]
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="SignOutAsync">
                    @L["Button.SignOut"]
                </MudButton>
            </MudPaper>
        </MudFocusTrap>
    </MudOverlay>
}
