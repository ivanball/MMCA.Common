@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using MMCA.Common.Shared.Auth
@using MMCA.Common.UI.Common
@using MMCA.Common.UI.Common.Interfaces
@using MMCA.Common.UI.Common.Settings
@using MMCA.Common.UI.Services.Auth
@inject IEnumerable<IUIModule> UIModules
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthUIService AuthService
@inject NavigationManager Navigation
@inject IOptions<LayoutSettings> LayoutSettingsOptions
@inject IStringLocalizer<SharedResource> L
@inject IStringLocalizerFactory LocalizerFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@RoutePaths.Home" aria-label="@L["Nav.BrandHome.Aria", LayoutSettingsOptions.Value.BrandName]">
            @* Decorative logo: alt="" keeps it out of the accessibility tree, because the link
               already announces itself through its aria-label (axe image-redundant-alt). Rendered
               only when the host configures Layout:BrandLogoUrl, so the text-only brand is unchanged. *@
            @if (!string.IsNullOrWhiteSpace(LayoutSettingsOptions.Value.BrandLogoUrl))
            {
                <img class="navbar-brand-logo" src="@LayoutSettingsOptions.Value.BrandLogoUrl" alt="" aria-hidden="true" />
            }
            <span class="navbar-brand-text">@LayoutSettingsOptions.Value.BrandName</span>
        </a>
    </div>
    @* Mobile-only quick actions (CSS hides this row at >=1024px, where the MudAppBar takes over; the
       app bar itself is hidden below 1024px). Culture + theme must be available to everyone here,
       authenticated or not (ADR-027/028); only the module app-bar components are gated on
       authentication. The signed-in user name deliberately does NOT repeat here: this row only ever
       renders below 1024px, which is exactly where .nav-auth-section opens the hamburger menu with
       the name above Logout, so a copy on the top row is pure duplication competing for the
       narrowest row in the layout. *@
    @* role="group": aria-label is prohibited on a generic div (WCAG 4.1.2 / axe aria-prohibited-attr),
       and the row is a labelled set of related controls, which is exactly what group means. *@
    <div class="toprow-actions" role="group" aria-label="@L["Nav.QuickActions.Aria"]">
        <CultureSwitcher />
        <ThemeToggle />
        <AuthorizeView>
            <Authorized>
                @foreach (var componentType in _appBarComponents)
                {
                    <DynamicComponent Type="componentType" />
                }
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@* The hamburger is a CSS-only checkbox, but it behaves as a disclosure button, so it is announced as
   one: role="button" is allowed on an input[type=checkbox] that carries no aria-checked, and it stops
   a screen reader reading "checkbox, not checked" for a menu toggle. aria-expanded is kept in step
   with the checked state (and re-synced after enhanced navigation) by wwwroot/navmenu.js, which also
   drives Enter, closes the menu on Escape, and returns focus here. *@
<input type="checkbox" title="@L["Nav.ToggleMenu.Aria"]" class="navbar-toggler"
       role="button"
       aria-label="@L["Nav.ToggleMenu.Aria"]" aria-expanded="false"
       aria-controls="nav-menu" />

<div class="nav-backdrop" aria-hidden="true"></div>

<nav id="nav-menu" class="nav-scrollable" aria-label="@L["Nav.SiteNavigation.Aria"]">
    @* The account block leads the menu (CSS renders it below 1024px only, where the MudAppBar that
       carries Logout on desktop is hidden). It sits above the navigation list because the menu is a
       scrolling column on a phone and an organizer or admin menu is long: at the top, the signed-in
       name and the way out are both reachable the moment the hamburger opens, with no scroll. *@
    <div class="nav-auth-section">
        <AuthorizeView>
            <Authorized>
                <div class="nav-user-identity">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                </div>
                <MudNavMenu Color="Color.Default">
                    @* Framework-owned account page: every host that renders this menu gets the
                       signed-in devices list without wiring a NavItem of its own. A host that sets
                       Layout:SessionsNavRequiredRole narrows the entry to that role; the default
                       (unset) keeps it visible to every signed-in user. The gate covers the menu
                       entry only: the page itself stays reachable for any signed-in account. *@
                    @if (_showSessionsLink)
                    {
                        <MudNavLink Href="@RoutePaths.Sessions" Icon="@Icons.Material.Filled.Devices">@L["Auth.Sessions.NavLabel"]</MudNavLink>
                    }
                    <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogoutAsync">@L["Common.Button.Logout"]</MudNavLink>
                </MudNavMenu>
            </Authorized>
            <NotAuthorized>
                <MudNavMenu Color="Color.Default">
                    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">@L["Common.Button.Login"]</MudNavLink>
                    <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">@L["Common.Button.Register"]</MudNavLink>
                </MudNavMenu>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <MudNavMenu Color="Color.Default">
        <MudNavLink Href="@RoutePaths.Home" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">@L["Nav.Home"]</MudNavLink>

        @foreach (var group in _generalItems.GroupBy(i => i.Group))
        {
            if (group.Key is not null)
            {
                <MudNavGroup Title="@DisplayGroup(group)" Icon="@Icons.Material.Filled.Folder" Expanded="false">
                    @foreach (var item in group)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                @foreach (var item in group)
                {
                    <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                }
            }
        }

        @if (_userItems.Count > 0 && _user?.Identity?.IsAuthenticated == true)
        {
            <div class="nav-section-label" role="heading" aria-level="2">@L["Nav.MyAccount"]</div>
            @foreach (var group in _userItems.GroupBy(i => i.Group))
            {
                if (group.Key is not null)
                {
                    <MudNavGroup Title="@DisplayGroup(group)" Icon="@Icons.Material.Filled.Folder" Expanded="false">
                        @foreach (var item in group)
                        {
                            <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                        }
                    </MudNavGroup>
                }
                else
                {
                    @foreach (var item in group)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                    }
                }
            }
        }

        @* Authentication is checked here as well as per item: NavItem.RequiredRole defaults to null,
           so a module that registers a Section.Admin item without one would otherwise disclose the
           admin feature's existence and URL to anonymous visitors. *@
        @if (_adminItems.Count > 0 && _user?.Identity?.IsAuthenticated == true)
        {
            <div class="nav-section-label" role="heading" aria-level="2">@L["Nav.Administration"]</div>
            @foreach (var group in _adminItems.GroupBy(i => i.Group))
            {
                if (group.Key is not null)
                {
                    <MudNavGroup Title="@DisplayGroup(group)" Icon="@Icons.Material.Filled.Folder" Expanded="false">
                        @foreach (var item in group)
                        {
                            <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                        }
                    </MudNavGroup>
                }
                else
                {
                    @foreach (var item in group)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon">@Display(item)</MudNavLink>
                    }
                }
            }
        }
    </MudNavMenu>
</nav>

@code {
    private ClaimsPrincipal? _user;
    private List<Type> _appBarComponents = [];
    private List<NavItem> _generalItems = [];
    private List<NavItem> _userItems = [];
    private List<NavItem> _adminItems = [];
    private bool _showSessionsLink;

    // ADR-027: Title and Group are resource keys resolved at render time against the item's
    // TitleResource resx pair, so the menu follows the active culture; a key the resource type does
    // not declare renders as the raw string.
    private string Display(NavItem item)
    {
        var localized = LocalizerFactory.Create(item.TitleResource)[item.Title];
        return localized.ResourceNotFound ? item.Title : localized.Value;
    }

    private string DisplayGroup(IGrouping<string?, NavItem> group)
    {
        if (group.Key is null)
        {
            return string.Empty;
        }

        var localized = LocalizerFactory.Create(group.First().TitleResource)[group.Key];
        return localized.ResourceNotFound ? group.Key : localized.Value;
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        var sessionsRole = LayoutSettingsOptions.Value.SessionsNavRequiredRole;
        _showSessionsLink = string.IsNullOrWhiteSpace(sessionsRole) || _user?.IsInRole(sessionsRole) == true;

        _appBarComponents = UIModules.SelectMany(m => m.AppBarComponentTypes).ToList();

        var allItems = UIModules
            .SelectMany(m => m.NavItems)
            .Where(item => item.RequiredRole is null || _user?.IsInRole(item.RequiredRole) == true)
            .Where(item => item.RequiredClaim is null || _user?.HasClaim(c => c.Type == item.RequiredClaim) == true)
            .Where(item => item.RequiredPermission is null
                || _user?.HasClaim(c => c.Type == AuthClaimTypes.Permission
                    && string.Equals(c.Value, item.RequiredPermission, StringComparison.Ordinal)) == true)
            .ToList();

        _generalItems = allItems.Where(i => i.Section is NavSection.General).ToList();
        _userItems = allItems.Where(i => i.Section is NavSection.User).ToList();
        _adminItems = allItems.Where(i => i.Section is NavSection.Admin).ToList();
    }
}
