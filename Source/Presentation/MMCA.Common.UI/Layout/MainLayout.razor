@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using MMCA.Common.UI.Common.Interfaces
@using MMCA.Common.UI.Pages.Common
@using MMCA.Common.UI.Services.Auth
@using Microsoft.Extensions.Options
@using MMCA.Common.UI.Common.Settings
@using MMCA.Common.UI.Components.Capabilities
@inject NavigationManager Navigation
@inject IAuthUIService AuthService
@inject IEnumerable<IUIModule> UIModules
@inject IOptions<LayoutSettings> LayoutSettingsOptions
@inject IOptions<LegalSettings> LegalSettingsOptions
@inject IStringLocalizer<SharedResource> L

<MmcaThemeProviders />
<DocumentLanguage />

@* The href names the CURRENT page: a bare "#main-content" resolves against <base href="/"> to the
   app root, and the router then navigates home from every other page. Once interactive, the click
   is handled in-page instead and moves focus to the main region (Blazor's own same-page fragment
   handling only scrolls, which leaves keyboard focus on the skip link). *@
<a href="@SkipLinkHref" class="skip-nav"
   @onclick="SkipToMainContentAsync" @onclick:preventDefault="true">@L["Layout.SkipToMainContent"]</a>

<div class="page">
    <aside class="sidebar" aria-label="@L["Layout.Sidebar.Aria"]">
        @* Complementary landmark wraps the whole sidebar so ALL of it — including NavMenu's brand top-row
           that sits above the inner <nav> — is contained by a landmark (axe region, best-practice). No
           role="navigation" on the <aside>: the inner NavMenu already renders the <nav>, and an <aside>
           may not carry that role (axe aria-allowed-role). *@
        <NavMenu />
    </aside>

    <main role="main">
        <div class="appbar-container">
            <MudAppBar Elevation="1" Dense="true" Fixed="false" aria-label="@L["Layout.AppBar.Aria"]">
                <div class="appbar-spacer"></div>
                @* Culture + theme controls are available to everyone, authenticated or not. *@
                <span class="appbar-icon-actions">
                    <CultureSwitcher />
                    <ThemeToggle />
                </span>
                <AuthorizeView>
                    <Authorized>
                        <span class="appbar-auth-items">
                            <span class="appbar-icon-actions">
                                @foreach (var componentType in _appBarComponents)
                                {
                                    <DynamicComponent Type="componentType" />
                                }
                            </span>
                            <MudText Typo="Typo.body2" Class="mr-4 user-name">@context.User.Identity?.Name</MudText>
                            <span class="appbar-text-actions">
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="HandleLogoutAsync"
                                           aria-label="@L["Common.Button.Logout.Aria"].Value">@L["Common.Button.Logout"]</MudButton>
                            </span>
                        </span>
                    </Authorized>
                    <NotAuthorized>
                        <span class="appbar-auth-items">
                            <span class="appbar-text-actions">
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">@L["Common.Button.Login"]</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/register">@L["Common.Button.Register"]</MudButton>
                            </span>
                        </span>
                    </NotAuthorized>
                </AuthorizeView>
            </MudAppBar>
        </div>
        @* tabindex="-1": the skip target must accept focus by script, or focus stays on the skip
           link and the next Tab walks the sidebar again. *@
        <article id="main-content" class="content px-4" tabindex="-1" @ref="_mainContent">
            @* Offline awareness (ADR-042 Wave 3): renders nothing while online; the Blazor
               Server fallback is always online, so only MAUI/WASM heads ever show it. *@
            <MMCA.Common.UI.Components.Capabilities.OfflineBanner />
            @* Module content headers (IUIModule.ContentHeaderComponentTypes): banners that belong
               above the page, inside the main landmark, rather than at the root layout level. *@
            @foreach (var componentType in _contentHeaderComponents)
            {
                <DynamicComponent Type="componentType" />
            }
            @Body
        </article>
    </main>
    @* The contentinfo (footer) landmark must be top-level, not nested inside <main> (axe landmark-contentinfo-is-top-level). *@
    @if (!string.IsNullOrWhiteSpace(LayoutSettingsOptions.Value.FooterText) || LegalSettingsOptions.Value.HasFooterLinks)
    {
        <footer class="app-footer" role="contentinfo">
            @if (!string.IsNullOrWhiteSpace(LayoutSettingsOptions.Value.FooterText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                    @LayoutSettingsOptions.Value.FooterText
                </MudText>
            }
            @if (LegalSettingsOptions.Value.HasFooterLinks)
            {
                @* The footer is visible at every width (MainLayout.razor.css hides only the app bar on
                   mobile), so the MAUI head and phones get these links here too. ExternalLink, not a raw
                   MudLink: inside a BlazorWebView target="_blank" dead-ends, and the wrapper opens the
                   system browser instead. Underline.Always keeps the links distinguishable without
                   relying on colour (WCAG 1.4.1). *@
                <nav class="app-footer-links" aria-label="@L["Layout.Footer.LegalLinks.Aria"]">
                    @if (!string.IsNullOrWhiteSpace(LegalSettingsOptions.Value.TermsUrl))
                    {
                        <ExternalLink Href="@LegalSettingsOptions.Value.TermsUrl" Underline="Underline.Always">@L["Legal.TermsOfService"]</ExternalLink>
                    }
                    @if (!string.IsNullOrWhiteSpace(LegalSettingsOptions.Value.PrivacyUrl))
                    {
                        <ExternalLink Href="@LegalSettingsOptions.Value.PrivacyUrl" Underline="Underline.Always">@L["Legal.PrivacyPolicy"]</ExternalLink>
                    }
                    @if (!string.IsNullOrWhiteSpace(LegalSettingsOptions.Value.CodeOfConductUrl))
                    {
                        <ExternalLink Href="@LegalSettingsOptions.Value.CodeOfConductUrl" Underline="Underline.Always">@L["Legal.CodeOfConduct"]</ExternalLink>
                    }
                </nav>
            }
        </footer>
    }
    @foreach (var componentType in _layoutComponents)
    {
        <DynamicComponent Type="componentType" />
    }
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Layout.UnhandledError"]
    <a href="." class="reload">@L["Layout.Reload"]</a>
    @* A real button, not a bare span: the dismiss has to be reachable by keyboard and carry an
       accessible name (WCAG 2.1.1 / 4.1.2). Blazor's own error-UI script binds the click by the
       .dismiss class, not by tag, so the behaviour is unchanged and no handler is needed here. *@
    <button type="button" class="dismiss" aria-label="@L["Layout.Dismiss"]">X</button>
</div>

@code {
    private List<Type> _appBarComponents = [];
    private List<Type> _layoutComponents = [];
    private List<Type> _contentHeaderComponents = [];
    private ElementReference _mainContent;

    // Base-relative path and query of the page being shown, plus the fragment. The router re-renders
    // the layout on every location change, so a list page's own URL rewrite is picked up too.
    private string SkipLinkHref
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var hashIndex = relative.IndexOf('#', StringComparison.Ordinal);
            return (hashIndex >= 0 ? relative[..hashIndex] : relative) + "#main-content";
        }
    }

    protected override void OnInitialized()
    {
        _appBarComponents = UIModules.SelectMany(m => m.AppBarComponentTypes).ToList();
        _layoutComponents = UIModules.SelectMany(m => m.LayoutComponentTypes).ToList();
        _contentHeaderComponents = UIModules.SelectMany(m => m.ContentHeaderComponentTypes).ToList();

        // Back the static ErrorMessages helper with the shared localizer (ADR-027). The layout renders for
        // every page in both Server and WASM, so this configures it once per circuit/host.
        ErrorMessages.Configure(L);
    }

    private Task SkipToMainContentAsync() => _mainContent.FocusAsync().AsTask();

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
