@using MMCA.Common.Shared.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Hosting
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject ICultureApplier CultureApplier
@inject IStringLocalizer<SharedResource> L

@* The name is text inside the activator, not MudMenu's AriaLabel: the Android WebView exposes no name
   for an aria-label on a button with aria-haspopup, which MudMenu always sets, so TalkBack read only
   its state. The toggle is on the menu root rather than the inner span because an accessibility
   click targets the role=button activator itself, and from there it only bubbles upwards.
   The focusable control is MudMenu's own activator wrapper (role=button, tabindex 0, Enter and Space
   handled by MudMenu), never a button placed inside it (axe nested-interactive). MudBlazor renders
   that wrapper display: contents, which takes no focus, so the culture-switcher class lets app.css
   give it a box: then forward Tab reaches it and the .mud-menu-activator focus rings draw around it. *@
<MudMenu @ref="_menu" Class="culture-switcher" Dense="true" @onclick="@(args => _menu.ToggleMenuAsync(args))">
    <ActivatorContent>
        <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" />
        <span class="visually-hidden">@L["Culture.Switcher.Label"]</span>
    </ActivatorContent>
    <ChildContent>
        @foreach (var culture in OfferedCultures)
        {
            <MudMenuItem OnClick="@(() => SetCulture(culture))">@GetCultureName(culture)</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    private MudMenu _menu = default!;

    // The supported cultures, plus the pseudo-localization locale in Development only (ADR-027 §8).
    // IHostEnvironment is registered on the Blazor Server host; on a WASM-only render it resolves to
    // null and the pseudo entry is simply not offered (a developer can still activate it via the
    // /culture/set endpoint, which the cookie reload re-reads).
    private IReadOnlyList<string> OfferedCultures =>
        Services.GetService<IHostEnvironment>()?.IsDevelopment() == true
            ? [.. SupportedCultures.All, SupportedCultures.PseudoLocale]
            : SupportedCultures.All;

    private string GetCultureName(string culture)
    {
        var localized = L[$"Culture.Name.{culture}"];
        return localized.ResourceNotFound ? culture : localized.Value;
    }

    private async Task SetCulture(string culture)
    {
        // Persist to the signed-in user's profile (best-effort; no-op when anonymous) before the reload.
        // The writer sends saves in call order, so this await also lets a theme save still in flight
        // finish (bounded) instead of the reload cutting it off.
        var writer = Services.GetService<IUserPreferenceWriter>();
        if (writer is not null)
        {
            await writer.SaveAsync(culture, theme: null);
        }

        // Host-specific from here: the web applier round-trips the /culture/set endpoint and reloads,
        // the MAUI applier switches the process culture in place. Both land back on the current page,
        // so this call is terminal (ADR-027).
        var current = new Uri(Navigation.Uri).PathAndQuery;
        await CultureApplier.ApplyAsync(culture, current);
    }
}
