@page "/Error"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using System.Diagnostics
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Localization
@using MMCA.Common.UI.Resources
@using MudBlazor
@inject IHostEnvironment Environment
@inject IStringLocalizer<SharedResource> L

@*
    SSR error page rendered by UseExceptionHandler("/Error") re-execution. Hoisted from the app Blazor
    Web hosts (it carries no app branding): its HttpContext cascading parameter is server-only, so it
    lives in MMCA.Common.UI.Web rather than the WASM-safe MMCA.Common.UI. Hosts pick it up by adding
    this package's assembly to MapRazorComponents().AddAdditionalAssemblies(...)
    (typeof(MMCA.Common.UI.Web._Imports).Assembly).
    The user-facing strings localize through SharedResource (ADR-027; request localization has already
    run when the exception handler re-executes the pipeline); the Development-mode block below is
    developer-only diagnostics and deliberately stays English.
*@

<PageTitle>@L["Error.PageTitle"]</PageTitle>

@* MudText with explicit HtmlTag keeps the heading outline (h1/h2/h3) while the theme owns the type
   scale and the error colour, so the page needs no CSS framework of its own. *@
<MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Error" Class="mb-2">@L["Error.Heading"]</MudText>
<MudText Typo="Typo.h6" HtmlTag="h2" Color="Color.Error" Class="mb-4">@L["Error.Message"]</MudText>

@if (ShowRequestId)
{
    <MudText Typo="Typo.body1" Class="mb-4">
        <strong>@L["Error.RequestId"]</strong> <code>@RequestId</code>
    </MudText>
}

@if (Environment.IsDevelopment())
{
    <MudText Typo="Typo.h6" HtmlTag="h3" Class="mb-2">Development Mode</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
        It can result in displaying sensitive information from exceptions to end users.
        For local debugging, enable the <strong>Development</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
        and restarting the app.
    </MudText>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
