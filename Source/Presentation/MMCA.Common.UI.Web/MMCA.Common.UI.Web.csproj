<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>MMCA.Common.UI.Web</PackageId>
    <Description>MMCA framework server-side Blazor Web host support: cookie-backed token storage, dynamic CSP provider, SSR error page, installable-web-app service worker, and host registration extensions</Description>
    <!-- Compile only against the three declared bridge references (UI, API, Aspire). Without this,
         NuGet injects API's transitive ProjectReferences (Infrastructure -> Application -> ...) into
         @(ProjectReference) and the EnforceUIWebLayerBoundary guard cannot tell a deliberate direct
         reference from transitive plumbing. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Hardening kit's exemption and partition helpers are internal: they are implementation
         detail of the limiter, not a surface a host calls, but the rule they encode (which paths are
         metered) has to be pinned by a unit test rather than by a full request flood. -->
    <InternalsVisibleTo Include="MMCA.Common.UI.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory fixed window with a remaining-window Retry-After, shared as one source file with
         MMCA.Common.API and MMCA.Common.Aspire (see the type's remarks for why it is not in Shared). -->
    <Compile Include="..\..\Build\RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" Link="RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <!-- The opt-in same-origin API proxy (AddCommonSameOriginApiProxy): YARP's IHttpForwarder carries
         the browser's /api calls and WebSocket upgrades to the gateway, and service discovery resolves
         the gateway the same way the host's own HttpClients do. Same pins as MMCA.Common.Gateway and
         MMCA.Common.Aspire. -->
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server-side bridge between the WASM-safe MMCA.Common.UI (ITokenStorageService, ApiSettings),
         the session-cookie plumbing in MMCA.Common.API, and the security-headers CSP extension point in
         MMCA.Common.Aspire. Deliberately a separate package: MMCA.Common.UI stays Shared-only for
         Blazor WASM compatibility and must never pull these server dependencies. -->
    <ProjectReference Include="..\MMCA.Common.UI\MMCA.Common.UI.csproj" />
    <ProjectReference Include="..\MMCA.Common.API\MMCA.Common.API.csproj" />
    <ProjectReference Include="..\..\Hosting\MMCA.Common.Aspire\MMCA.Common.Aspire.csproj" />
    <!-- Shared is every package's base layer and already a transitive dependency of all three bridges;
         referenced directly because DisableTransitiveProjectReferences hides it from the compiler, and
         the UI limiter's Retry-After header comes from the one helper there (RetryAfterHeader). -->
    <ProjectReference Include="..\..\Core\MMCA.Common.Shared\MMCA.Common.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service worker scripts MapCommonServiceWorker serves at the site root. Embedded rather
         than shipped under wwwroot: a worker served from /_content/... could control only that folder,
         and the endpoint writes the package version into the script so each release updates it. -->
    <EmbeddedResource Include="Pwa\*.js" LogicalName="MMCA.Common.UI.Web.Pwa.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
