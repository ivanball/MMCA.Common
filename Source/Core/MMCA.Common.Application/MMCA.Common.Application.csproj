<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Application</PackageId>
    <Description>MMCA framework: CQRS handlers, decorators, module system, query service</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MMCA.Common.Application.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- ModuleLoader loads each module's modules.{name}.json via AddJsonFile. This used to arrive
         transitively through MiniProfiler.AspNetCore.Mvc's ASP.NET Core graph: an accidental
         dependency on a web package for a host-agnostic feature. Referenced directly now. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.FeatureManagement" />

    <!-- MiniProfiler.Shared, NOT MiniProfiler.AspNetCore.Mvc: the profiling decorators only touch
         StackExchange.Profiling.MiniProfiler.Current/Step, which lives in the shared package. The
         ASP.NET Core packages belong to whoever hosts the profiler UI (MMCA.Common.API), and pulling
         them in here would drag MVC into a host-agnostic package. PackageGraphPurityTests guards it. -->
    <PackageReference Include="MiniProfiler.Shared" />
    <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scrutor" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MMCA.Common.Domain\MMCA.Common.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
