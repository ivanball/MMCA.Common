<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.AI</PackageId>
    <Description>MMCA framework: a governed, provider-agnostic Microsoft.Extensions.AI IChatClient. Versioned prompt contracts with a stable hash, per-call output-token / timeout / model bounds, a tool-use gate, guardrails, token-usage metrics, and one configuration section; the provider itself comes from an adapter package (MMCA.Common.AI.Anthropic, MMCA.Common.AI.OpenAI) so the model dependency stays isolated, evaluated, observable and swappable</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- IHostEnvironment (the Development-only sensitive-data gate), IDistributedCache (the opt-in
         response cache), the configuration binder and the options validation pipeline all arrive on
         the shared framework rather than as standalone packages, exactly as they do in
         MMCA.Common.Infrastructure and MMCA.Common.Gateway. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="MMCA.Common.AI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The only runtime dependency, and deliberately NO MMCA.Common project reference and NO
         vendor SDK. This package is the language-model boundary: everything it governs (a prompt
         contract, a bounded delegating client, a usage meter) is expressed in Microsoft.Extensions.AI
         primitives, so it needs nothing from Domain, Application or Infrastructure and must stay
         installable by a host that has taken none of them. The vendor SDKs live one package out,
         in MMCA.Common.AI.Anthropic and MMCA.Common.AI.OpenAI, each contributing one
         IAiProviderFactory: a host references the adapter for the provider it configured and
         nothing else, and this package never learns which one. The direction is enforced the other
         way instead: no MMCA layer may reference this package outside Infrastructure
         (EnforceAiLayerBoundary in MMCA.Common.LayerEnforcement.targets, plus
         AiDependencyIsolationTestsBase at runtime).

         Microsoft.Extensions.AI brings Microsoft.Extensions.AI.Abstractions (IChatClient,
         ChatOptions, UsageDetails, ChatClientMetadata) plus the pipeline pieces this package
         composes: UseLogging, UseOpenTelemetry and UseDistributedCache. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
