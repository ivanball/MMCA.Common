<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Gateway</PackageId>
    <Description>MMCA framework YARP gateway building blocks: shared cluster request profiles (defaults plus per-cluster overrides), route/cluster trace headers, named per-route rate-limiter policies, and passive health-check defaults</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="MMCA.Common.Gateway.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ONLY runtime dependency. Deliberately no reference to MMCA.Common.Aspire: this package
         is the YARP layer and must stay usable by a gateway that has not taken the OpenTelemetry /
         Redis / health-check graph that AddServiceDefaults brings. The two compose at the host
         instead (see GatewayRoutePolicyExtensions' summary on the global limiter). -->
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- A linked SOURCE file, not a reference: the in-memory fixed window with a remaining-window
         Retry-After that API, Aspire and UI.Web compile in too. Yarp.ReverseProxy stays the only
         runtime dependency. -->
    <Compile Include="..\..\Build\RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" Link="RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
