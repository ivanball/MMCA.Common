<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Aspire.Hosting</PackageId>
    <Description>MMCA framework: Aspire AppHost extension methods for the cross-cutting infrastructure (RabbitMQ broker, JWKS service discovery, gRPC project wiring) used by extracted microservice deployments</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MMCA.Common.Aspire.Hosting.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MailDev host ports, shared as one linked source file with MMCA.Common.Testing.E2E (which
         reads the inbox) so neither package references the other; see MailDevDefaults. -->
    <Compile Include="..\..\Build\MailDev\MailDevDefaults.cs" Link="MailDev\MailDevDefaults.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <!-- Aspire 17 project resources: AddDotnetProject returns IResourceBuilder<DotnetProjectResource>,
         the receiver and return type of every service-wiring extension in this package. -->
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <!-- WithSQLServerDataSource wires a service to its own SqlServerDatabaseResource (database per
         microservice). This pulls in Aspire.Hosting.SqlServer for the resource type. -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <!-- Direct reference lifting the System.Security.Cryptography.Pkcs transitive (10.0.12 from
         Aspire.Hosting.SqlServer, 9.0.13 from SqlClient) off the vulnerable versions (NU1903); see
         the pin note in Directory.Packages.props. Consumer AppHosts inherit the lift from here. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- WithPostgreSQLDataSource wires a service to its own PostgresDatabaseResource (ADR-113).
         Pulls in Aspire.Hosting.PostgreSQL for the resource type. -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- WithCosmosDataSource wires a service to an Azure Cosmos DB database resource (polyglot
         persistence). Pulls in Aspire.Hosting.Azure.CosmosDB for the resource type. -->
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
