<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Aspire</PackageId>
    <Description>MMCA framework Aspire service defaults: OpenTelemetry, health checks, service discovery, HTTP resilience</Description>
    <IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="MMCA.Common.Aspire.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The in-memory fixed window with a remaining-window Retry-After, shared as one source file with
         MMCA.Common.API and MMCA.Common.UI.Web (see the type's remarks for why it is not in Shared). -->
    <Compile Include="..\..\Build\RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" Link="RateLimiting\RemainingWindowFixedWindowRateLimiter.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dependency readiness checks are the framework's own IHealthCheck classes (Health/), one
         per engine, so each driver below is referenced directly. RabbitMQ.Client: the broker check
         (Health/RabbitMqHealthCheck over Health/RabbitMqHealthConnection). -->
    <PackageReference Include="RabbitMQ.Client" />
    <!-- Readiness probe for a PostgreSQL data source (ADR-113, Health/PostgreSqlHealthCheck), on the
         same 10.x driver MMCA.Common.Infrastructure's EF provider uses. -->
    <PackageReference Include="Npgsql" />
    <!-- Readiness probe for a SQLite database (Health/SqliteHealthCheck). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Readiness probe for a SQL Server database (Health/SqlServerHealthCheck), on the same 7.x
         driver as MMCA.Common.Infrastructure. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Direct reference lifting SqlClient's System.Security.Cryptography.Pkcs transitive off the
         vulnerable 9.0.18 (NU1903); see the pin note in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Redis wiring is owned by the framework (Caching/RedisCachingExtensions): the raw Aspire
         integrations register an untagged health check that gates readiness and issues CLUSTER INFO,
         which Azure Managed Redis refuses. The wrapper turns those checks off and Common contributes
         a PING-only check instead (Health/RedisPingHealthCheck), which is why StackExchange.Redis is
         a direct reference here and AspNetCore.HealthChecks.Redis is deliberately NOT referenced. -->
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <!-- Direct reference to force transitive OpenTelemetry.Api resolution to non-vulnerable 1.15.3. -->
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- Host logging bootstrap (Logging/SerilogHostExtensions.AddCommonSerilog). Serilog lands on
         this package rather than MMCA.Common.API because the bootstrap runs on the
         WebApplicationBuilder immediately before AddServiceDefaults, alongside the other host-wiring
         extensions here, and it needs no Application/Infrastructure type. -->
    <!-- Security pin: Microsoft.Data.Sqlite (the SQLite health check above) has a SQLitePCLRaw
         floor of the vulnerable 2.1.6. Forces it to the patched build, same pattern (and same
         reason) as the reference in MMCA.Common.Infrastructure. See the
         SQLitePCLRaw.bundle_e_sqlite3 note in Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared holds HttpResilienceDefaults — the single source of truth for the resilience
         values this package and MMCA.Common.Grpc must keep identical. -->
    <ProjectReference Include="..\..\Core\MMCA.Common.Shared\MMCA.Common.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
