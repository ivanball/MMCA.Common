<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Azure</PackageId>
    <Description>MMCA framework: the Microsoft Azure adapter. Azure Blob file storage, Notification Hubs native push, the Azure Service Bus transport, the Entra SQL authentication provider and Entra token login for Azure Database for PostgreSQL, plus (through MMCA.Common.Azure.Startup) Key Vault configuration, the Azure Monitor exporter and the Blob + Key Vault DataProtection key ring; the core packages stay cloud-neutral</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="MMCA.Common.Azure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The adapter's whole job is to hold the Azure SDKs so the core packages do not have to
         (EnforceCloudVendorBoundary in Source/Build/MMCA.Common.LayerEnforcement.targets and
         CloudVendorIsolationTestsBase hold that line). A host references this package only when it
         runs on Azure, and opts into each capability with one registration call. Key Vault
         configuration, the Azure Monitor exporter and the DataProtection key ring live in
         MMCA.Common.Azure.Startup (referenced below and type-forwarded from here), so a host that only
         needs start-up wiring can take that package alone. -->
    <!-- DefaultAzureCredential for Blob storage. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Azure Service Bus transport (Messaging/AzureServiceBusTransport): the data-plane client, the
         processor and the administration client the topology is provisioned through. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <!-- SqlClient 7.0 moved the Entra ID providers (Active Directory Managed Identity, Default, ...)
         out of the core driver into this extension package, which registers them on load. Without it a
         production host whose connection string says Authentication=Active Directory Managed Identity
         throws "Cannot find an authentication provider" at startup (ADC, 2026-09-16). It needs no
         registration call: a host that references this package carries it in its dependency graph.
         Keep the version in step with Microsoft.Data.SqlClient; SqlClientEntraAuthenticationTests pins
         the registration. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <!-- Entra token login for Redis (Redis/AzureRedisEntraAuthenticationConfigurator): the token
         acquisition and the re-authentication of open connections before each token expires. -->
    <PackageReference Include="Microsoft.Azure.StackExchangeRedis" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MMCA.Common.Infrastructure\MMCA.Common.Infrastructure.csproj" />
    <ProjectReference Include="..\MMCA.Common.Aspire\MMCA.Common.Aspire.csproj" />
    <ProjectReference Include="..\MMCA.Common.Azure.Startup\MMCA.Common.Azure.Startup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
