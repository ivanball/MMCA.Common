<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Aws</PackageId>
    <Description>MMCA framework: the AWS adapter. S3-compatible file storage (AWS S3, Cloudflare R2, MinIO, the GCS XML API) and the Amazon SQS/SNS broker transport; the core packages stay cloud-neutral</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="MMCA.Common.Aws.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The adapter's whole job is to hold the AWS SDKs so the core packages do not have to
         (EnforceCloudVendorBoundary in Source/Build/MMCA.Common.LayerEnforcement.targets and
         CloudVendorIsolationTestsBase hold that line). A host references this package only when it
         runs on AWS or an S3-compatible store, and opts into each capability with one registration
         call. -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- Amazon SQS/SNS transport. It brings AWSSDK.SQS and AWSSDK.SimpleNotificationService. -->
    <PackageReference Include="MassTransit.AmazonSQS" />
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\MMCA.Common.Infrastructure\MMCA.Common.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
