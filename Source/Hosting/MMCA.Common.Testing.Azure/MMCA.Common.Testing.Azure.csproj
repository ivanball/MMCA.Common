<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MMCA.Common.Testing.Azure</PackageId>
    <Description>MMCA framework Azure test infrastructure: the Service Bus emulator broker-parity fixture base (Testcontainers + the framework's own Azure Service Bus transport)</Description>
    <!-- Same documentation relaxations as MMCA.Common.Testing (test infrastructure). -->
    <NoWarn>$(NoWarn);SA1600;SA1601;SA1602;SA1611;SA1615;SA1618;SA1623;SA1629;SA1642;SA1649;CA1054;CA2234;S2743</NoWarn>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.Azure: the fixture's transport host is a generic
         host (Microsoft.Extensions.Hosting) from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- ServiceBusEmulatorFixtureBase owns the Azure Service Bus emulator container, its two clients and
         the one transport host for the broker-parity tier. Consumers of this tier need a Docker daemon.
         Azure.Messaging.ServiceBus 7.20.2 is the first line with working emulator admin-plane support. -->
    <PackageReference Include="Testcontainers.ServiceBus" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
  <ItemGroup>
    <!-- The transport under test: the fixture runs the production Azure Service Bus transport
         (AddAzureServiceBusTransport + AddBrokerMessaging) against the emulator. -->
    <ProjectReference Include="..\MMCA.Common.Azure\MMCA.Common.Azure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
