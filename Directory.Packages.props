<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Per-target-framework versions (dual-TFM policy, build/Frameworks.props). A package whose version
    must follow the target framework takes it from one of these properties; every other package
    keeps a single literal pin below. The first group is the .NET 10 line, the second overrides it
    for net11.0 and anything compatible with it (net11.0-android and the other platform TFMs).
    The empty-TargetFramework guard matters: the outer build of a multi-targeted project evaluates
    this file with no TargetFramework, and IsTargetFrameworkCompatible rejects an empty moniker.

      MmcaFrameworkVersion  ASP.NET Core, the runtime Microsoft.Extensions.* packages and
                            System.Security.Cryptography.Pkcs: they ship with the runtime.
      MmcaEfCoreVersion     Entity Framework Core. HELD at the 10.0 line on BOTH frameworks: the
                            only Npgsql.EntityFrameworkCore.PostgreSQL 11 build is 11.0.0-rc.3, which
                            pins EF Core to exactly that rc (NU1608 against 11.0.0). EF Core 10 runs
                            on the .NET 11 runtime. Set 11.0.0 in the second group, together with
                            the Npgsql provider pin, when Npgsql ships its 11.0.0.
      MmcaOpenApiVersion    Microsoft.OpenApi: ASP.NET Core 10 constrains it below 3.0.0 and
                            ASP.NET Core 11 needs the 3.x line.
      MmcaMauiVersion       Microsoft.Maui.Controls and Microsoft.AspNetCore.Components.WebView.Maui
                            (MMCA.Common.UI.Maui only). MAUI majors follow the .NET major, and a
                            consumer head pins the same value for its own framework.
      MmcaMauiToolkitVersion
                            CommunityToolkit.Maui, which binds to the MAUI major: 16.x is the MAUI 10
                            line, 17.x the MAUI 11 line.
      MmcaAndroidBiometricVersion
                            Xamarin.AndroidX.Biometric. MAUI 10 needs the HELD 1.1.0.30 (see the pin
                            below); MAUI 11's Essentials requires at least 1.1.0.33 (NU1605 on the
                            older one).
      MmcaExtensionsVersion The dotnet/extensions train (Microsoft.Extensions.Http.Resilience,
                            ServiceDiscovery, Caching.Hybrid, AI, AI.OpenAI, TimeProvider.Testing).
                            Its 11.x net10.0 assets floor the runtime Microsoft.Extensions.* packages
                            at 11.0.0, so the .NET 10 line stays on 10.x and only net11.0 takes 11.x.
      MmcaAspNetOAuthVersion
                            AspNet.Security.OAuth.Apple and .GitHub: 11.x ships net11.0 assets only.
  -->
  <PropertyGroup>
    <MmcaFrameworkVersion>10.0.15</MmcaFrameworkVersion>
    <MmcaEfCoreVersion>11.0.0</MmcaEfCoreVersion>
    <MmcaOpenApiVersion>2.13.0</MmcaOpenApiVersion>
    <MmcaMauiVersion>10.0.130</MmcaMauiVersion>
    <MmcaMauiToolkitVersion>16.0.0</MmcaMauiToolkitVersion>
    <MmcaAndroidBiometricVersion>1.1.0.30</MmcaAndroidBiometricVersion>
    <MmcaExtensionsVersion>10.11.0</MmcaExtensionsVersion>
    <MmcaAspNetOAuthVersion>10.1.0</MmcaAspNetOAuthVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <MmcaFrameworkVersion>11.0.0</MmcaFrameworkVersion>
    <MmcaOpenApiVersion>3.11.0</MmcaOpenApiVersion>
    <MmcaMauiVersion>11.0.10</MmcaMauiVersion>
    <MmcaMauiToolkitVersion>17.0.0</MmcaMauiToolkitVersion>
    <MmcaAndroidBiometricVersion>1.1.0.33</MmcaAndroidBiometricVersion>
    <MmcaExtensionsVersion>11.0.0</MmcaExtensionsVersion>
    <MmcaAspNetOAuthVersion>11.0.0</MmcaAspNetOAuthVersion>
  </PropertyGroup>
  <!--
    CentralPackageTransitivePinningEnabled is deliberately NOT set in this workspace: CPM pins DIRECT
    PackageReferences only. So lifting a transitive package (a security bump, most often) takes TWO
    edits, never one: a PackageVersion entry here AND a direct PackageReference in a project that
    flows that package onward, otherwise the pin is inert and the vulnerable version still resolves.
    Worked exemplars below: the Microsoft.OpenApi and MessagePack pins, each with its own note.
  -->
  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MmcaFrameworkVersion)" />
    <!-- External OAuth providers for the config-gated AddExternalAuthProviders / OAuthControllerBase (inert without OAuth:*:ClientId). -->
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="$(MmcaAspNetOAuthVersion)" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="$(MmcaAspNetOAuthVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="$(MmcaFrameworkVersion)" />
    <!-- Generic OIDC providers (OAuth:Oidc:<Name>), registered by the same AddExternalAuthProviders call. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MmcaFrameworkVersion)" />
    <!-- Direct pin to bump the transitive Microsoft.OpenApi off 2.0.0 (pulled by AspNetCore.OpenApi)
         to the first patched version for GHSA-v5pm-xwqc-g5wc (circular-schema-reference DoS in OpenAPI
         parsing); referenced directly in MMCA.Common.API so the pin takes effect (no transitive pinning). -->
    <!-- HELD on the 2.x line (latest 2.x taken): NU1608 vs Microsoft.AspNetCore.OpenApi 10.0.x, which
         constrains Microsoft.OpenApi to (>= 2.7.5 && < 3.0.0).
         The 3.x line cannot be taken until the ASP.NET Core 10 OpenAPI stack moves off the 2.x range. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="$(MmcaOpenApiVersion)" />
    <!-- Application -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <!-- Application references MiniProfiler.Shared only (host-agnostic); the ASP.NET Core / MVC
         package is referenced by MMCA.Common.API, which owns the profiler UI and middleware. -->
    <PackageVersion Include="MiniProfiler.Shared" Version="4.5.4" />
    <PackageVersion Include="MiniProfiler.AspNetCore.Mvc" Version="4.5.4" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="$(MmcaFrameworkVersion)" />
    <!-- Pinned to a patched version to override the vulnerable MessagePack pulled transitively by
         SignalR.StackExchangeRedis (2.5.187) and Aspire.Hosting (2.5.192). GHSA-hv8m-jj95-wg3x /
         CVE-2026-48109 (high, CVSS 8.2 — LZ4 decompression OOB read); fixed in 2.5.301. Forced via a
         direct PackageReference in MMCA.Common.Infrastructure + .Aspire.Hosting (same pattern as
         OpenTelemetry.Api below) so the fix flows to consumers through the published package graph.
         Moved to the 3.x line on 2026-08-28: both dependents constrain MessagePack with a lower
         bound only, so the major bump restores and builds clean and carries the same fix. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Cosmos" Version="$(MmcaEfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MmcaEfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(MmcaEfCoreVersion)" />
    <!-- Pins the transitive SQLitePCLRaw bundle (EF Core Sqlite floors it at the vulnerable 2.1.11) to
         a patched build for GHSA-2m69-gcr7-jv3q / CVE-2025-6965; referenced directly in
         MMCA.Common.Infrastructure and MMCA.Common.Aspire (whose Sqlite health check pulls
         Microsoft.Data.Sqlite) so the fix flows to consumers through the published package graph
         (same pattern as the MessagePack pin above). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MmcaEfCoreVersion)" />
    <!-- PostgreSQL provider (ADR-113). Npgsql ships on its own cadence, so its version tracks the EF
         Core MAJOR (10.x) rather than the exact 10.0.14 patch the Microsoft-owned providers share;
         10.0.3 is the current stable build for EF Core 10. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MmcaEfCoreVersion)" />
    <PackageVersion Include="MiniProfiler.EntityFrameworkCore" Version="4.5.4" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <!-- Two-level cache (L1 in-process + L2 distributed) behind AddCommonHybridCache
         (HybridCacheService). Deliberately writes under its own disjoint 'hc:' keyspace so it can
         never cross-read an entry another writer put in the same server: two serialization formats
         sharing one key is the WRONGTYPE production failure this framework already paid for once.
         Kept on the same dotnet/extensions train as Http.Resilience, ServiceDiscovery and
         TimeProvider.Testing, so it moves with them rather than ahead of them: a Caching.Hybrid
         release floors Microsoft.Extensions.Caching.Abstractions/Memory (and through them
         DependencyInjection.Abstractions, Logging.Abstractions, Options, Primitives) at its own
         train's servicing version. Projects with the framework reference prune those away, but the
         ones without it resolve them as real packages, so a pin ahead of the train quietly moves five
         shared transitives across the graph for no functional gain. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="$(MmcaExtensionsVersion)" />
    <!-- Cron expression parsing for the opt-in recurring job scheduler (ScheduledJobRunner). MIT,
         zero-dependency (netstandard2.0, no transitive graph at all), and it does exactly one thing:
         parse a five-field expression and answer "what is the next occurrence after this UTC
         instant". Deliberately NOT Hangfire or Quartz: both ship their own persistence, their own
         worker/thread model and their own dashboards, all of which duplicate machinery this
         framework already owns and has production history with (the OutboxProcessor claim-lease
         idiom, the DI scope-per-execution pattern, the OpenTelemetry meters). The only piece the
         framework lacked was the cron grammar, so that is the only piece taken as a dependency. -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- RFC 6238 TOTP grammar behind the opt-in two-factor second factor (MMCA.Common.Infrastructure).
         MIT and zero-dependency (netstandard2.0), and it does exactly one thing the BCL has no
         primitive for: derive and verify a time-stepped one-time code, plus the Base32 alphabet the
         authenticator apps key from. The rest of the feature (secret storage, recovery codes, the
         claim) is framework code, so this is the only piece taken as a dependency, and it is
         referenced from Infrastructure alone: Application, Domain and Shared stay dependency-free. -->
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <!-- WebAuthn registration and assertion verification behind the opt-in AddPasskeys (ADR-139).
         MIT, .NET Foundation. Pinned exactly: it parses attacker-supplied CBOR/COSE, so a bump is a
         reviewed change, never a floating range. Referenced from the opt-in MMCA.Common.Passkeys
         package alone (it pulls NSec.Cryptography and the native libsodium), so a host that does not
         reference that package carries none of it; EnforcePasskeysBoundary keeps it there. -->
    <PackageVersion Include="Fido2" Version="4.3.3" />
    <!-- Direct pin to lift the transitive System.Formats.Cbor off 9.0.0 (pulled by Fido2) to the
         first patched version for GHSA-vmv3-wvjp-wqpj / CVE-2026-118747 (moderate, denial of
         service in the CBOR reader, which is exactly what Fido2 feeds attacker-supplied bytes to).
         It follows the framework version (10.0.15 / 11.0.0, both patched) and is referenced
         directly in MMCA.Common.Passkeys so the pin takes effect and flows to consumers. -->
    <PackageVersion Include="System.Formats.Cbor" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- AI (MMCA.Common.AI) -->
    <!-- Microsoft.Extensions.AI is the abstraction the governed client is written against
         (IChatClient, ChatOptions, UsageDetails) plus the pipeline pieces it composes (UseLogging,
         UseOpenTelemetry, UseDistributedCache). It carries Microsoft.Extensions.AI.Abstractions, so
         there is no second entry for it. The 10.x line floors the shared Microsoft.Extensions
         transitives (Caching/DependencyInjection/Logging Abstractions) at 10.0.12, one servicing
         patch above the 10.0.11 the rest of this file sits on; that lift is confined to
         MMCA.Common.AI's own lock file because no other project references this package. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MmcaExtensionsVersion)" />
    <!-- The OFFICIAL Anthropic .NET SDK (MIT, by Anthropic), taken for one reason: it ships its own
         Microsoft.Extensions.AI adapter (Microsoft.Extensions.AI.AnthropicClientExtensions
         .AsIChatClient), so the provider half of the governed client is a construction rather than a
         hand-rolled HttpClient against the Messages API, and the request/response shapes track the
         API from the vendor instead of from this repo. Its only non-BCL dependency is
         Microsoft.Extensions.AI.Abstractions, the same package the entry above already brings. -->
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <!-- The OpenAI adapter (MMCA.Common.AI.OpenAI): Microsoft.Extensions.AI.OpenAI is Microsoft's
         AsIChatClient adapter over the official OpenAI .NET SDK and tracks the Microsoft.Extensions.AI
         line above, so the two bump together; OpenAI is referenced directly by the adapter project so
         the vendor SDK is pinned here like Anthropic is, not floated by the adapter's own floor. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MmcaExtensionsVersion)" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <!-- MCP (MMCA.Common.Mcp): the official Model Context Protocol C# SDK, server half over ASP.NET
         Core. Referenced by MMCA.Common.Mcp alone, so no core package carries it (ADR-134). Pinned
         EXACTLY: the SDK moved 1.x to 2.x within a year and its filter and transport surface changed
         between minors, so a bump is a deliberate re-read of the filter API, never a float. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Messaging (MassTransit) -->
    <!-- Pinned to v8 (free). v9.x introduced a commercial license requirement; the bus fails the
         license check at startup ("License must be specified with SetLicense/SetLicenseLocation
         or by setting the MT_LICENSE/MT_LICENSE_PATH environment variables") and every broker-
         enabled service host crashes. A blanket package-update bumped this to 9.1.2 once before
         and reintroduced the crash: do NOT bump past v8 without configuring a license. -->
    <PackageVersion Include="MassTransit" Version="8.5.12" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <PackageVersion Include="MassTransit.Azure.ServiceBus.Core" Version="8.5.12" />
    <!-- Amazon SQS/SNS transport (MMCA.Common.Aws), Apache-2.0 like the rest of the v8 line. Same
         version as every MassTransit pin above: the transports and the core bump together. -->
    <PackageVersion Include="MassTransit.AmazonSQS" Version="8.5.12" />
    <!-- PostgreSQL SQL transport, the built-in cloud-neutral broker in MMCA.Common.Infrastructure
         (MessageBus:Provider=PostgreSql): queues, topics and scheduling in tables of a PostgreSQL
         database, so any managed Postgres (Cloud SQL, RDS, Azure Database) is a broker. Apache-2.0,
         same v8 line and version as every MassTransit pin above. Brings Dapper; its Npgsql floor
         resolves to the Npgsql pin below. -->
    <PackageVersion Include="MassTransit.SqlTransport.PostgreSQL" Version="8.5.12" />
    <!-- Azure Service Bus transport (MMCA.Common.Azure) and its emulator test tier (ServiceBusEmulatorFixtureBase in MMCA.Common.Testing.Azure): the two
         clients the MassTransit v8 custom-clients Host() overload takes. 7.20.2 is the first line with
         working emulator admin-plane support (>= 7.20.1 required), and it also lifts the older
         transitive MassTransit.Azure.ServiceBus.Core would otherwise resolve. -->
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <!-- Native push (ADR-044): Azure Notification Hubs installations + FCM v1 / APNs native sends. -->
    <PackageVersion Include="Microsoft.Azure.NotificationHubs" Version="4.2.0" />
    <!-- Managed file storage (ADR-045): the MMCA.Common.Azure Blob Storage adapter and its
         Azure.Identity credential. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- S3-compatible file storage (MMCA.Common.Aws.AddS3FileStorage): AWS S3, Cloudflare R2, MinIO
         and the GCS XML API through one client. The 4.x line sends request checksums by default,
         which the adapter turns down to WHEN_REQUIRED for the S3-compatible services. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <!-- The AWS telemetry exporter (MMCA.Common.Aws.AddAwsTelemetryExporter) signs its OTLP requests
         with Amazon.Runtime.Signing.AWSSigV4Signer, which AWSSDK.Core 4.0.3.17 lacks. Direct pin so the
         signer is guaranteed rather than inherited from whichever service package floors highest.
         Same AWS SDK v4 line as AWSSDK.S3. -->
    <PackageVersion Include="AWSSDK.Core" Version="4.1.0" />
    <!-- Secrets Manager configuration source (MMCA.Common.Aws.AddAwsSecretsManagerConfiguration):
         a hand-written provider that lists the secrets under one name prefix and reads them in
         batches. Same AWS SDK v4 line as AWSSDK.S3, so both share one AWSSDK.Core. -->
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.1.1" />
    <!-- Shared DataProtection key ring (MMCA.Common.Aws.AddAwsDataProtection): each key is one
         SecureString parameter in Systems Manager, KMS-encrypted at rest. AWS-authored; brings
         AWSSDK.SimpleSystemsManagement and AWSSDK.Extensions.NETCore.Setup on the same v4 line. -->
    <PackageVersion Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.3" />
    <!-- RDS IAM database authentication for PostgreSQL (MMCA.Common.Aws.AddAwsRdsIamAuthentication):
         only RDSAuthTokenGenerator is used, which signs the token locally with SigV4. Same AWS SDK
         v4 line as AWSSDK.S3. -->
    <PackageVersion Include="AWSSDK.RDS" Version="4.1.0" />
    <!-- SNS mobile push (MMCA.Common.Aws.AddAmazonSnsPush): platform endpoints and
         per-endpoint publishes. Also a transitive dependency of MassTransit.AmazonSQS (which
         floors it at 4.0.100.15); the direct pin must stay at or above that floor so both paths
         resolve one assembly. Same AWS SDK v4 line as AWSSDK.S3. -->
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.1.0" />
    <!-- The native push installation registry (MMCA.Common.Aws.AddAmazonSnsPush): one DynamoDB item
         per installation, a conditional put for the ownership rule and a UserId index for
         user-targeted sends. Low-level client only. Same AWS SDK v4 line as AWSSDK.S3. -->
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.1.0" />
    <!-- Google Cloud Storage file storage (MMCA.Common.Gcp.AddGoogleCloudStorage): the JSON API
         client over Application Default Credentials (workload identity, no HMAC keys). Brings the
         Google.Apis.* REST stack and Google.Api.Gax.Rest; no gRPC. Apache-2.0. -->
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <!-- Secret Manager as a configuration source (MMCA.Common.Gcp.AddGoogleSecretManagerConfiguration):
         a hand-written provider that lists the secrets under one name prefix and reads the latest
         version of each through the synchronous client methods. gRPC over Google.Api.Gax.Grpc and
         Grpc.Net.Client; Apache-2.0. -->
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="3.0.0" />
    <!-- Cloud KMS encryption of the DataProtection key ring at rest
         (MMCA.Common.Gcp.AddGoogleCloudDataProtection, DataProtection:GcpKmsKeyName). The official
         Google.Cloud.AspNetCore.DataProtection.Kms is prerelease only (a stable package cannot
         depend on it, NU5104), so the IXmlEncryptor/IXmlDecryptor pair is hand-written over this
         client. Same Google.Api.Gax.Grpc line as Secret Manager; Apache-2.0. -->
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <!-- Cloud SQL IAM database authentication (MMCA.Common.Gcp.AddCloudSqlIamAuthentication): an
         OAuth2 access token from Application Default Credentials for the sqlservice.login scope, used
         as the PostgreSQL password. Pinned at the version the Cloud clients above already resolve
         transitively, so the direct reference moves nothing in the graph; Apache-2.0. -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.78.0" />
    <!-- Firebase Cloud Messaging native push (MMCA.Common.Gcp.AddFirebaseCloudMessagingPush): the
         HTTP v1 send (SendEachAsync), over Application Default
         Credentials. Google-authored on the same Google.Apis.Auth line as the Cloud clients; Apache-2.0. -->
    <PackageVersion Include="FirebaseAdmin" Version="3.7.1" />
    <!-- The FCM installation registry (MMCA.Common.Gcp.AddFirebaseCloudMessagingPush): one Firestore
         document per installation, a transaction for the ownership rule and a UserId equality query
         for user-targeted sends. gRPC over Google.Api.Gax.Grpc, the Secret Manager line; Apache-2.0. -->
    <PackageVersion Include="Google.Cloud.Firestore" Version="4.6.0" />
    <!-- Shared DataProtection key ring (MMCA.Common.Azure.AddAzureDataProtection). Blobs persists
         the key ring so every replica decrypts the same auth cookies and antiforgery tokens; Keys is
         the optional at-rest encryption of that key ring. Both reuse the Azure.Identity pin above. -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <!-- Pinned directly to lift the transitive off GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7
         (NU1903/NU1902, every version up to 9.0.20 and 10.0.12): Microsoft.Data.SqlClient 7.x pulls
         9.0.13 or 9.0.18 and Aspire.Hosting.SqlServer pulls 10.0.12. The shared framework does not
         carry this package, so nothing prunes it. Lifted by direct references in the four projects
         that take those packages directly (Infrastructure, Testing, Aspire, Aspire.Hosting); everything else
         inherits it through a project reference. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MmcaFrameworkVersion)" />
    <!-- Azure Key Vault as a configuration source (MMCA.Common.Azure.AddAzureKeyVaultConfiguration).
         Opt-in and gated on KeyVault:Uri, so an unconfigured host never contacts a vault and local
         development stays Azure-free. Reuses the Azure.Identity pin above for the
         DefaultAzureCredential the provider authenticates with; the host identity needs the
         Key Vault Secrets User role on the vault (samples/deployment/DEPLOYMENT.md, bootstrap step 3). -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <!-- gRPC -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <!-- Common.UI -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(MmcaFrameworkVersion)" />
    <!-- Deliberately the ASP.NET Core 2.3.x package on net10.0: it is what brings HttpContext and
         StatusCodes (via Microsoft.AspNetCore.Http.Abstractions 2.3.x) into Common.UI, which
         Pages/NotFound.razor needs for its 403 re-execution check. Common.UI is consumed by Blazor
         WebAssembly clients, so <FrameworkReference Include="Microsoft.AspNetCore.App" /> cannot
         replace it. Removing it means moving that check into a server-only project first. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.14" />
    <!-- Direct pin to lift the transitive Microsoft.AspNetCore.WebUtilities off 2.3.12 (pulled by
         Mvc.Core 2.3.14 through Microsoft.AspNetCore.Http 2.3.13) to the first patched version for
         GHSA-6527-9fp8-r4x6 / CVE-2026-118750 (moderate, denial of service); referenced directly in
         MMCA.Common.UI so the pin takes effect (no transitive pinning) and flows to consumers through
         the published package graph. Drop it when Mvc.Core itself depends on 2.3.14 or later. -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="MudBlazor" Version="9.13.0" />
    <PackageVersion Include="Polly" Version="8.9.1" />
    <!-- Circuit breaker on the outbox broker-publish path (MMCA.Common.Infrastructure). Polly.Core
         rather than the Polly meta-package: Core carries the v8 resilience-pipeline API on its own,
         while Polly adds the v7 Policy compatibility shim that Infrastructure has no use for. Kept
         on the same version as the Polly pin above so the two never resolve to different Core
         assemblies in one graph. -->
    <PackageVersion Include="Polly.Core" Version="8.9.1" />
    <!-- QR encoding for the shared QrCodeImage component (MIT). Pure managed encode-to-PNG: no
         native binary, no network call, no image service, so it renders identically on every head
         including Blazor WebAssembly. -->
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- Common.UI.Maui — must match the Microsoft.Maui.Controls pin the consumer heads use
         (ADC/Store pin the same version); MAUI plugin/toolkit packages bind to the MAUI minor,
         so bump them together, never independently. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MmcaMauiVersion)" />
    <!-- Local (on-device) notifications for UI.Maui; majors track MAUI majors — verify the
         net10 TFM set before bumping (14.x is the net10 line). -->
    <PackageVersion Include="Plugin.LocalNotification" Version="14.1.2" />
    <!-- Speech-to-text for UI.Maui; hard-binds to the MAUI minor (16.x requires Controls >= 10.0.90),
         bump together with Microsoft.Maui.Controls. -->
    <PackageVersion Include="CommunityToolkit.Maui" Version="$(MmcaMauiToolkitVersion)" />
    <!-- Android-only biometric prompt binding for UI.Maui (platform-direct, ADR-042 Wave 4).
         Pinned to the release built against MAUI 10.0.70's AndroidX train (Fragment 1.8.8.x /
         Lifecycle 2.9.2.x); newer builds (.32+) pull AndroidX versions past the Ktx packages'
         upper bounds and fail restore with NU1608. Bump together with Microsoft.Maui.Controls. -->
    <!-- HELD at 1.1.0.30 ON MAUI 10 (MmcaAndroidBiometricVersion) 2026-08-28, re-verified 2026-10-25 on MAUI 10.0.120: 1.1.0.33 still reproduces the NU1608 wave above on MAUI
         10.0.100 (Fragment 1.8.9.3 / Activity 1.13.0.1 / Lifecycle 2.11.0.1 / SavedState 1.5.0.1 /
         Collection.Jvm 1.6.0.1 resolved past the .Ktx packages' upper bounds). -->
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="$(MmcaAndroidBiometricVersion)" />
    <!-- Android-only Firebase Cloud Messaging binding for UI.Maui's FCM device-token provider
         (ADR-044). Bindings track the Google Play services train, not the MAUI one, but they pull
         AndroidX packages: verify a restore of the android TFM after any bump (the Biometric pin
         above is the one that reacts first, with NU1608). -->
    <!-- HELD at 124.1.2 2026-08-28, re-verified 2026-10-25 on MAUI 10.0.120 with 125.1.3: 125.1.1 pulls the newer AndroidX train (Lifecycle 2.11.0.1,
         Activity 1.13.0.1, Fragment 1.8.9.3, SavedState 1.5.0.1, Collection.Jvm 1.6.0.1) past the
         .Ktx packages' upper bounds and fails the android restore with NU1608. Re-verified 2026-11-11
         on MAUI 11.0.10 (the net11.0-android target): 125.1.3 fails the same way (Fragment 1.9.0 and
         Tracing 2.0.0 past the .Ktx upper bounds), so the hold covers both frameworks. -->
    <PackageVersion Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
    <!-- BlazorWebView host support for UI.Maui (Wave 5: MainPageBase / NativeThemeSync);
         versions on the MAUI train, bump together with Microsoft.Maui.Controls. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MmcaMauiVersion)" />
    <!-- Camera barcode/QR scanning for UI.Maui's opt-in IBarcodeScannerService (MIT, by Redth).
         Ships net10.0 assets for all four MAUI platforms (net10.0-android36.0 / -ios26.0 /
         -maccatalyst26.0 / -windows10.0.19041) and depends on Microsoft.Maui.Controls, so it
         binds to the MAUI train: bump together with Microsoft.Maui.Controls. The net11.0 platform
         targets take the same assets (0.10.4 is the newest release and restores against MAUI 11). -->
    <PackageVersion Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
    <!-- Analyzers -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.339" />
    <!-- Public API surface gate (RS0016/RS0017): every packable Source project carries a
         PublicAPI.Shipped.txt baseline, so adding or removing a public member is a deliberate,
         reviewable diff instead of an accident discovered by a consumer. Source-only (see the
         PublicApiAnalyzers ItemGroup in Directory.Build.props). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <!-- Testing -->
    <!-- bUnit v2 (BunitContext / Render API) is the line compatible with xUnit v3 / Microsoft Testing Platform. -->
    <PackageVersion Include="bunit" Version="2.15.2" />
    <!-- AngleSharp is transitive through bUnit. The direct pin dates from bUnit 2.7.2, which floored it at
         1.4.0 (CVE-2026-54570 / GHSA-pgww-w46g-26qg, mXSS via MathML annotation-xml, fixed in 1.5.2); bUnit
         2.13.3 now floors it at 1.8.6. CPM does not pin transitives, so the two bUnit-referencing projects
         keep a direct PackageReference to hold it at this central version.
         1.8.6 adds an IHtmlSelectElement member that bUnit 2.12.5's generated HtmlSelectElementWrapper
         does not implement (TypeLoadException on set_SelectedIndex in every bUnit Find), so 1.8.6 moved
         only together with bUnit 2.13.3, which declares it as its own dependency. Keep the two in step. -->
    <PackageVersion Include="AngleSharp" Version="1.10.2" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <!-- Pin the transitive Commons explicitly to 4.12.0 (= Playwright 4.12.0's floor): CPM does not pin
         transitives, so a stale-cache restore could otherwise drift it down to 4.7.2 and dirty the lock. -->
    <PackageVersion Include="Deque.AxeCore.Commons" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Redis integration tier only (Tests/Core/MMCA.Common.Infrastructure.Redis.Tests, outside the
         .slnx, own CI job): a real Redis is the only way to assert the storage FORMAT the cache
         writes, which a Mock<IDistributedCache> answers for and therefore cannot get wrong.
         Microsoft.Extensions.Caching.StackExchangeRedis supplies the concrete RedisCache the shipped
         code only sees as IDistributedCache. -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <!-- Multi-host cross-service fixture base in MMCA.Common.Testing (Wave 5.8): SQL Server +
         RabbitMQ containers for consumer cross-service integration tiers. Test-tier only. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- PostgreSQL integration tier only (Tests/Core/MMCA.Common.Infrastructure.PostgreSQL.Tests,
         outside the .slnx, own CI job): the SQL a provider actually emits (partial-index predicates,
         boolean comparisons, timestamp kinds) is the class of thing only a real server can reject,
         and no in-memory or SQLite substitute reproduces it. Same Testcontainers family version as
         the Redis and MsSql pins. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <!-- Service Bus emulator fixture base in MMCA.Common.Testing.Azure: same Testcontainers family version.
         The module starts the emulator plus its companion SQL container, so consumer broker-parity
         tiers need a Docker daemon (nightly/dispatch jobs only, never a merge gate). -->
    <PackageVersion Include="Testcontainers.ServiceBus" Version="4.16.0" />
    <!-- AWS integration tier only (Tests/Hosting/MMCA.Common.Aws.Integration.Tests, outside the
         .slnx, own CI job): S3 and SQS/SNS against LocalStack. Same Testcontainers family version. -->
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.16.0" />
    <!-- Google Cloud emulator tier only (Tests/Hosting/MMCA.Common.Gcp.Emulator.Tests, outside the
         .slnx, own CI job): fake-gcs-server has no Testcontainers module, so the tier runs it as a
         generic container on the core package. Same Testcontainers family version. -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!-- Google Cloud emulator tier only: the Firestore emulator for the FCM installation registry.
         Same Testcontainers family version. -->
    <PackageVersion Include="Testcontainers.Firestore" Version="4.16.0" />
    <!-- Pinned directly to force transitive resolution to the patched version: every Testcontainers
         package floors SSH.NET at 2025.1.0, which carries GHSA-q939-rpr3-3284 (high, published
         2026-08-12: ScpClient recursive download lets a malicious server write arbitrary files via
         server-controlled SCP filenames); fixed in 2026.0.0. CPM does not pin transitives, so the
         projects that pull Testcontainers add a direct PackageReference (same pattern as the
         MessagePack and SQLitePCLRaw pins above), which also carries the fix to consumers of the
         MMCA.Common.Testing package through the published package graph. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Benchmark smoke harness only (Tests/Performance, outside the .slnx) — rubric §12. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MmcaFrameworkVersion)" />
    <!-- FakeTimeProvider for deterministic clock-driven tests (OutboxCleanupService sweep, session-cookie
         expiry); version matches the Microsoft.Extensions dotnet/extensions family (Http.Resilience,
         ServiceDiscovery) above. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MmcaExtensionsVersion)" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- Test tier only (Tests/Hosting/MMCA.Common.Aspire.Tests): an in-memory metric reader is the
         only way to prove that the Telemetry:Disable*Metrics knobs actually drop a stream, rather
         than merely skipping one AddXInstrumentation call that another component re-adds. Version
         tracks the OpenTelemetry family pinned below. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <!-- Shared integration-test scaffolding (MMCA.Common.Testing.Fixtures.SqlServerIntegrationTestFixtureBase):
         in-process host boot + throwaway SQL database + Respawn reset. SqlClient is referenced directly
         only by MMCA.Common.Testing and CPM does not pin transitives, so every other project keeps
         resolving the 6.1.6 that EF Core SqlServer 10.0.11 floors. On the 7.0 line since 2026-08-28:
         Aspire.Hosting already pulls 7.0.1 into the AppHost graph, so the test-tier pin sits on
         the same major the hosting stack does. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MmcaFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <!-- Same version as Microsoft.Data.SqlClient: since 7.0 the Entra ID authentication providers live
         here, and MMCA.Common.Azure references it so every Azure host that connects with
         Authentication=Active Directory Managed Identity keeps working (the 2026-09-16 ADC startup
         failure). Bump the two together. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- Health Checks. AspNetCore.HealthChecks.Redis is deliberately absent: its check issues
         CLUSTER INFO against any server StackExchange.Redis 3.x reports as clustered, which Azure
         Managed Redis (Enterprise tier) refuses outside admin mode, so every probe threw against a
         healthy cache. MMCA.Common.Aspire ships a PING-only replacement instead
         (Health/RedisPingHealthCheck). The package still arrives transitively through
         Aspire.StackExchange.Redis, which is harmless because the Aspire checks are switched off at
         registration (Caching/RedisCachingExtensions) and this repo does not enable central
         transitive pinning, so no PackageVersion entry is required to keep the restore graph valid. -->
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <!-- Readiness probe for a PostgreSQL source (ADR-113), the peer of the SqlServer and Sqlite
         checks below. Npgsql is pinned directly alongside it in MMCA.Common.Aspire so the ADO driver
         the check opens a connection with is the same 10.x build the EF provider uses, rather than
         the older floor this health-check package carries. -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="AspNetCore.HealthChecks.Sqlite" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <!-- Gateway (MMCA.Common.Gateway and MMCA.Common.Testing) — the YARP reverse proxy the shared
         gateway building blocks are written against; MMCA.Common.Testing takes it for the gateway
         hardening test base and its recording forwarder. Deliberately not referenced from
         MMCA.Common.Aspire: a service host that takes AddServiceDefaults must not inherit a proxy
         dependency it never uses. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Aspire / ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MmcaExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MmcaExtensionsVersion)" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!-- OpenTelemetry.Api pinned directly to force transitive resolution to non-vulnerable version. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- Serilog, for MMCA.Common.Aspire's AddCommonSerilog: the host-logging bootstrap every
         service host repeated verbatim. Serilog.AspNetCore supplies the ILoggingBuilder.AddSerilog
         provider registration (never UseSerilog, which would replace the whole ILoggerFactory and
         silence the OpenTelemetry provider AddServiceDefaults adds); the two sink packages are the
         console and rolling-file sinks the shared configuration writes to. Versions match the pins
         both consumer apps already carry. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Redis client integrations (MMCA.Common.Aspire.Caching.RedisCachingExtensions). Held at the
         same version the hosting stack sits on, and matching the pins both consumer apps already
         carry, so a host that swaps its direct Aspire references for the framework wrapper resolves
         exactly the same assemblies. Microsoft.AspNetCore.OutputCaching.StackExchangeRedis is the
         shared Redis output-cache store the wrapper registers; it ships no health check of its own. -->
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.5" />
    <PackageVersion Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" Version="$(MmcaFrameworkVersion)" />
    <!-- Aspire AppHost -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <!-- AppHost integration testing (MMCA.Common.Testing.Aspire): DistributedApplicationTestingBuilder
         boots a real AppHost in-process. Held at the SAME version as every other Aspire entry on
         purpose: the testing host builds the application model the AppHost package produces, so a
         version split between the two is a model mismatch rather than an upgrade. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <!-- Aspire.Hosting.AppHost has no pin: the sample AppHost (apphost-testing CI tier, outside
         MMCA.Common.slnx) uses Aspire.AppHost.Sdk as its project SDK, which references it at the
         SDK's own version, the same shape as the consumer AppHosts. -->
    <!-- Versioning -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
