<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.Azure.Startup itself, so DataProtection and the
         hosting abstractions prune to the shared framework instead of resolving as standalone packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The start-up package only: the boundary tests read this assembly's own reference list, and
         no test here reaches Azure (Key Vault, the exporter and the key ring are asserted for their
         shape, never for a request). -->
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Azure.Startup\MMCA.Common.Azure.Startup.csproj" />
  </ItemGroup>
</Project>
