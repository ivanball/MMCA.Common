<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.Gcp itself, so the hosting abstractions prune
         to the shared framework instead of resolving as standalone packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Moq" />
  </ItemGroup>
  <ItemGroup>
    <!-- No test here reaches Google Cloud: clients are built against a placeholder endpoint and
         asserted for their configuration, and the storage service runs against a mocked
         StorageClient. The real round trips live in the emulator tier
         (Tests/Hosting/MMCA.Common.Gcp.Emulator.Tests). -->
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Gcp\MMCA.Common.Gcp.csproj" />
    <!-- For CloudVendorRulesTests: the Google SDK assemblies this project already loads are the
         fixtures that prove the cloud-vendor rules reject a Google dependency. -->
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Testing.Architecture\MMCA.Common.Testing.Architecture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared builder double for the secret-store configuration tests (also linked by the other cloud adapter test projects). -->
    <Compile Include="..\..\Shared\Hosting\SourceCollectingHostApplicationBuilder.cs" Link="Shared\Hosting\SourceCollectingHostApplicationBuilder.cs" />
    <!-- Shared contract bases for the vendor-neutral cases (each linked by every cloud adapter test project that runs it). -->
    <Compile Include="..\..\Shared\Hosting\PostgreSqlTokenAuthenticationTestsBase.cs" Link="Shared\Hosting\PostgreSqlTokenAuthenticationTestsBase.cs" />
    <Compile Include="..\..\Shared\Hosting\SecretStoreConfigurationExtensionsTestsBase.cs" Link="Shared\Hosting\SecretStoreConfigurationExtensionsTestsBase.cs" />
    <Compile Include="..\..\Shared\Hosting\FileStorageServiceFailureTestsBase.cs" Link="Shared\Hosting\FileStorageServiceFailureTestsBase.cs" />
  </ItemGroup>
</Project>
