<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Testing.Aspire\MMCA.Common.Testing.Aspire.csproj" />
    <!-- The two packages whose constants AppHostProbePaths MIRRORS. They are referenced HERE, in the
         test project, and deliberately not from the package under test: the whole point of mirroring
         is that an AppHost-tier test package does not drag the service-defaults graph or the API
         layer into a consumer's test project. The cross-assert is what keeps a rename honest. -->
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Aspire\MMCA.Common.Aspire.csproj" />
    <ProjectReference Include="..\..\..\Source\Presentation\MMCA.Common.API\MMCA.Common.API.csproj" />
  </ItemGroup>
</Project>
