<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Exercises the Google Cloud adapter against fake-gcs-server via Testcontainers: Cloud Storage
         object storage and the DataProtection key ring (its generation-precondition writes), plus the
         FCM installation registry against the Firestore emulator (its ownership transactions). NOT shipped and deliberately NOT in MMCA.Common.slnx: it needs a Docker
         daemon and runs in its own CI job (gcp-integration), kept out of the fast solution-wide unit
         feedback loop (same posture as the AWS LocalStack, Redis, PostgreSQL and SQL Server tiers).

         This tier exists because the unit tier can only assert the object the adapter BUILDS: that
         the JSON API accepts its resumable upload, that Content-Type, Content-Disposition and
         Cache-Control come back as object metadata, that the returned URL addresses the object and
         that a delete of a missing object maps to success are claims only a real endpoint can settle. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.Gcp itself. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <!-- fake-gcs-server has no Testcontainers module, so the fixture runs it as a generic container. -->
    <PackageReference Include="Testcontainers" />
    <!-- The Firestore emulator behind the FCM installation registry (FCM itself has no emulator). -->
    <PackageReference Include="Testcontainers.Firestore" />
    <!-- Direct only to lift the vulnerable SSH.NET that Testcontainers floors at 2025.1.0
         (GHSA-q939-rpr3-3284). This project has no path to MMCA.Common.Testing, so it cannot
         inherit that pin and needs its own. See the comment in Directory.Packages.props. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Gcp\MMCA.Common.Gcp.csproj" />
  </ItemGroup>
</Project>
