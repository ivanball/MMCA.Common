<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Exercises the AWS adapter against LocalStack via Testcontainers: S3 object storage and the
         SQS/SNS broker transport. NOT shipped and deliberately NOT in MMCA.Common.slnx: it needs a
         Docker daemon and runs in its own CI job (aws-integration), kept out of the fast
         solution-wide unit feedback loop (same posture as the Redis, PostgreSQL and SQL Server tiers).

         This tier exists because the unit tier can only assert the requests the adapter BUILDS: that
         the S3-compatible API accepts them with the checksum posture and addressing style the adapter
         picks, that Content-Type and Content-Disposition come back on the object, and that the
         ambient MMCA-* headers survive SNS + SQS (whose 10-attribute cap MassTransit does not police)
         are claims only a real endpoint can settle. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.Aws itself. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.LocalStack" />
    <!-- Direct only to lift the vulnerable SSH.NET that Testcontainers floors at 2025.1.0
         (GHSA-q939-rpr3-3284). This project has no path to MMCA.Common.Testing, so it cannot
         inherit that pin and needs its own. See the comment in Directory.Packages.props. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\Hosting\MMCA.Common.Aws\MMCA.Common.Aws.csproj" />
  </ItemGroup>
</Project>
