@page "/components"
@using MMCA.Common.Shared.Abstractions
@using MMCA.Common.UI.Components.Notifications

<PageTitle>Components</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <PageHeader Title="Components Gallery">
        <NotificationBell />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="ShowDeleteConfirmationAsync">
            Delete sample
        </MudButton>
    </PageHeader>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Empty state</MudText>
    <MudPaper Outlined="true" Class="pa-2">
        <EmptyState Message="No records found." />
    </MudPaper>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Loading state</MudText>
    <MudPaper Outlined="true" Class="pa-2">
        <PageLoadingState Label="Loading sample data" />
    </MudPaper>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Error state</MudText>
    <MudPaper Outlined="true" Class="pa-2">
        <PageErrorState Message="Could not load the sample data." />
    </MudPaper>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Detail load failed</MudText>
    <MudPaper Outlined="true" Class="pa-2">
        <DetailLoadStateContent State="DetailLoadState.Failed" />
    </MudPaper>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Unsaved-changes guard</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Dirty state: @(_isDirty ? "unsaved changes" : "clean")
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _isDirty = !_isDirty)" data-testid="toggle-dirty">
        Toggle unsaved changes
    </MudButton>
    <UnsavedChangesGuard IsDirty="_isDirty" />

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Mobile infinite-scroll list</MudText>
    <MobileInfiniteScrollList TItem="SampleItem" FetchPageResult="FetchSamplePageAsync" PageSize="3"
                              EmptyMessage="No items to show.">
        <CardTemplate>
            <MudText Typo="Typo.subtitle2">@context.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@context.Description</MudText>
        </CardTemplate>
    </MobileInfiniteScrollList>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">List page shell</MudText>
    <ListPageShell TItem="SampleItem" Title="Sample rooms"
                   SearchText="@_shellSearch" SearchTextChanged="@(value => _shellSearch = value)"
                   MobileFetch="FetchSamplePageAsync" ServerData="LoadSampleGridAsync"
                   EmptyConfirmed="true" EmptyMessage="No items to show."
                   ShowDeleteConfirmation="false">
        <CardTemplate>
            <MudText Typo="Typo.subtitle2">@context.Name</MudText>
        </CardTemplate>
        <Columns>
            <PropertyColumn T="SampleItem" TProperty="string" Property="x => x.Name" Title="Name">
                <CellTemplate>
                    <RowLinkCell Href="/components">@context.Item.Name</RowLinkCell>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn T="SampleItem" TProperty="string" Property="x => x.Description" Title="Description" />
        </Columns>
    </ListPageShell>

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">Touch target affordance</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Icon buttons carrying the shared <c>mmca-touch-target</c> class meet the WCAG 2.5.5/2.5.8
        48px minimum hit area on mobile viewports.
    </MudText>
    <MudPaper Outlined="true" Class="pa-2">
        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                       Class="mmca-touch-target"
                       aria-label="Touch target sample"
                       Color="Color.Primary" />
    </MudPaper>
</MudContainer>

<DeleteConfirmation @ref="_deleteConfirmation" EntityType="Item" />

@code {
    private sealed record SampleItem(string Name, string Description);

    private readonly IReadOnlyList<SampleItem> _items =
    [
        new("First item", "A sample card rendered by MobileInfiniteScrollList."),
        new("Second item", "Another sample card with secondary text."),
        new("Third item", "Cards stack vertically on narrow viewports."),
    ];

    private bool _isDirty;
    private string _shellSearch = string.Empty;
    private DeleteConfirmation _deleteConfirmation = null!;

    private Task ShowDeleteConfirmationAsync() => _deleteConfirmation.ShowAsync("First item");

    private Task<Result<(IReadOnlyList<SampleItem> Items, int TotalItems)>> FetchSamplePageAsync(
        int page, int pageSize, CancellationToken cancellationToken)
        => Task.FromResult(Result.Success<(IReadOnlyList<SampleItem>, int)>((_items, _items.Count)));

    private Task<GridData<SampleItem>> LoadSampleGridAsync(GridState<SampleItem> state, CancellationToken cancellationToken)
        => Task.FromResult(new GridData<SampleItem> { Items = _items, TotalItems = _items.Count });
}
