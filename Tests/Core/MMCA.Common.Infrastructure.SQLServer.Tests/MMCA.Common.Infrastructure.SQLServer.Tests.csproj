<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Exercises the shipped SQLServerDbContext and DbContextFactory against a REAL SQL Server via
         Testcontainers. NOT shipped and deliberately NOT in MMCA.Common.slnx: it needs a Docker daemon
         and runs in its own CI job (sqlserver-integration), kept out of the fast solution-wide unit
         feedback loop (same posture as MMCA.Common.Infrastructure.PostgreSQL.Tests and
         MMCA.Common.Infrastructure.Redis.Tests).

         This tier exists because the unit tier structurally cannot catch the class of bug it covers:
         SESSION state and server-generated values. SET IDENTITY_INSERT only holds on the session that
         ran it, a rowversion is written by the server, and the outbox row must reach the same
         transaction as the aggregate; a mocked or SQLite context models none of the three. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- CS1591 ratchet (FR-7): remove when this project is fully documented -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\Core\MMCA.Common.Infrastructure\MMCA.Common.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stubs and the BatchedDelete scenario shared by the SQL Server and PostgreSQL provider tiers. -->
    <Compile Include="..\..\Shared\Persistence\PersistenceTestDoubles.cs" Link="Shared\Persistence\PersistenceTestDoubles.cs" />
    <Compile Include="..\..\Shared\Persistence\BatchedDeleteScenario.cs" Link="Shared\Persistence\BatchedDeleteScenario.cs" />
  </ItemGroup>
</Project>
