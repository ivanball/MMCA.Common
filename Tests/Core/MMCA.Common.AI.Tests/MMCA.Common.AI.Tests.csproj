<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Matches the FrameworkReference on MMCA.Common.AI itself, so IHostEnvironment, the
         configuration binder and the options validation pipeline the registration tests drive prune
         to the shared framework instead of resolving as standalone packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The governed package plus both adapters: the provider tests construct each adapter's client
         with a fake key and assert its shape and metadata, never a request. No test here reaches a
         network, and the project carries no credential a test could accidentally use. -->
    <ProjectReference Include="..\..\..\Source\Core\MMCA.Common.AI\MMCA.Common.AI.csproj" />
    <ProjectReference Include="..\..\..\Source\Core\MMCA.Common.AI.Anthropic\MMCA.Common.AI.Anthropic.csproj" />
    <ProjectReference Include="..\..\..\Source\Core\MMCA.Common.AI.OpenAI\MMCA.Common.AI.OpenAI.csproj" />
  </ItemGroup>
</Project>
